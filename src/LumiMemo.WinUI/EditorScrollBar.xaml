<?xml version="1.0" encoding="utf-8" ?>
<!--
    编辑器专用滚动条：只留一个圆角滑块，显隐/宽细完全由 RichEditorHost 的代码驱动——
    出现时从右缘滑出、消失时向右滑回边线（弹出/收起），滚动指示为细条（4px）、
    悬停由细变粗（8px）。刻意不放任何 VisualState：系统"始终显示滚动条"设置会让
    模板状态变成常驻细条，绕开它的办法就是不用状态机。模板保留 ScrollBar 代码
    需要的全部 16 个命名部件（缺一个模板就会应用失败）。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 空按钮与滑块的两个子模板（WinUI 的 ControlTemplate 没有 Resources 成员，只能放字典层）。 -->
    <ControlTemplate x:Key="EmptyRepeatButton" TargetType="RepeatButton">
        <Grid Background="Transparent" />
    </ControlTemplate>
    <ControlTemplate x:Key="BarThumb" TargetType="Thumb">
        <Rectangle RadiusX="3" RadiusY="3" Fill="{ThemeResource ScrollBarThumbFill}" />
    </ControlTemplate>

    <Style TargetType="ScrollBar" BasedOn="{StaticResource DefaultScrollBarStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid x:Name="Root">
                        <!-- 水平方向：保留全部命名部件（ScrollBar 代码无空值保护抓取），零尺寸不可见。 -->
                        <Grid x:Name="HorizontalRoot" IsHitTestVisible="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <RepeatButton x:Name="HorizontalSmallDecrease" Width="0" Template="{StaticResource EmptyRepeatButton}" />
                            <RepeatButton x:Name="HorizontalLargeDecrease" Grid.Column="1" Width="0" Template="{StaticResource EmptyRepeatButton}" />
                            <Thumb x:Name="HorizontalThumb" Grid.Column="2" Width="0" Height="0" Opacity="0" Template="{StaticResource BarThumb}" />
                            <RepeatButton x:Name="HorizontalLargeIncrease" Grid.Column="3" Template="{StaticResource EmptyRepeatButton}" />
                            <RepeatButton x:Name="HorizontalSmallIncrease" Grid.Column="4" Width="0" Template="{StaticResource EmptyRepeatButton}" />
                        </Grid>
                        <Grid x:Name="HorizontalPanningRoot" Visibility="Collapsed" Opacity="0">
                            <Border x:Name="HorizontalPanningThumb" Height="2"
                                    Background="{ThemeResource ScrollBarPanningThumbBackground}" />
                        </Grid>

                        <Grid x:Name="VerticalRoot" Background="{TemplateBinding Background}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <RepeatButton x:Name="VerticalSmallDecrease" Height="0" Template="{StaticResource EmptyRepeatButton}" />
                            <!-- 高度由 ScrollBar 代码写入（UpdateTrackLayout），不要设固定值。 -->
                            <RepeatButton x:Name="VerticalLargeDecrease" Grid.Row="1" Template="{StaticResource EmptyRepeatButton}" />
                            <Thumb x:Name="VerticalThumb" Tag="vthumb" Grid.Row="2"
                                   Width="4" MinHeight="30"
                                   HorizontalAlignment="Right"
                                   Margin="0,0,1,0"
                                   Template="{StaticResource BarThumb}">
                                <!-- X=12 是"收起"位：整个滑块藏在右缘之外，出现时动画滑回 0。 -->
                                <Thumb.RenderTransform>
                                    <TranslateTransform x:Name="VerticalThumbShift" X="12" />
                                </Thumb.RenderTransform>
                            </Thumb>
                            <RepeatButton x:Name="VerticalLargeIncrease" Grid.Row="3" Template="{StaticResource EmptyRepeatButton}" />
                            <RepeatButton x:Name="VerticalSmallIncrease" Grid.Row="4" Height="0" Template="{StaticResource EmptyRepeatButton}" />
                        </Grid>

                        <Grid x:Name="VerticalPanningRoot" Visibility="Collapsed" Opacity="0">
                            <Border x:Name="VerticalPanningThumb" Width="2" MinHeight="32"
                                    HorizontalAlignment="Right"
                                    Background="{ThemeResource ScrollBarPanningThumbBackground}" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
