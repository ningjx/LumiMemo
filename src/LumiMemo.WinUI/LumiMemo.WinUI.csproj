<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>LumiMemo.WinUI</RootNamespace>
    <AssemblyName>LumiMemo.WinUI</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('Assets\AppIcon.ico')">Assets\AppIcon.ico</ApplicationIcon>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>false</EnableMsixTooling>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LumiMemo.Core\LumiMemo.Core.csproj" />
    <ProjectReference Include="..\LumiMemo.Infrastructure\LumiMemo.Infrastructure.csproj" />
    <!--
      LumiText 独立渲染器库（D5 决策，docs/design/custom-renderer-framework.md）。
      当前仅引用不启用：正式接入走 Phase 4 的开关灰度，RichEditBox 仍是生产编辑器。
    -->
    <ProjectReference Include="..\LumiText\LumiText.WinUI\LumiText.WinUI.csproj" />
  </ItemGroup>

  <!--
    编辑器的纯逻辑助手（RtfPict / AdornerGeometry 等）刻意保持 internal——它们是实现细节、
    不是对外契约；开放给测试工程用 InternalsVisibleTo，比为了测试把它们提成 public 更稳妥。
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="LumiMemo.WinUI.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="H.NotifyIcon.WinUI" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\AppIcon.ico" />
    <!-- 图标字体（Fluent UI System Icons，MIT）：运行时按 ms-appx:///Assets/… 引用，必须进输出目录。
         单文件自解压发布（IncludeAllContentForSelfExtract）靠的也是这条 Content。 -->
    <Content Include="Assets\FluentSystemIcons-Regular.ttf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

</Project>
