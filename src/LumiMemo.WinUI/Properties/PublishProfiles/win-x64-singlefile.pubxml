<?xml version="1.0" encoding="utf-8"?>
<!--
  注意：这个配置产出的单文件 exe **跑不起来**，不要用它做发布。
  WinUI 3 不支持单文件发布：Windows App SDK 的原生依赖必须与 exe 同目录，
  单文件模式下宿主在下载目录、原生 DLL 自解压到 %TEMP%\.net\…，
  运行时找不到 DLL 就静默退出（没有日志、没有事件记录）——2026-10-04 实测。
  官方文档：package-and-deploy/self-contained-deploy/deploy-self-contained-apps
  正式发布走 win-x64.pubxml（自包含文件夹），工作流再打成一个 zip。
-->
<Project>
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>None</DebugType>
  </PropertyGroup>
</Project>
