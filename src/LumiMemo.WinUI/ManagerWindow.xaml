<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="LumiMemo.WinUI.ManagerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tb="using:H.NotifyIcon"
    Title="LumiMemo 便笺列表">

    <Grid x:Name="Root" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <Grid x:Name="ManagerTitleBar" Padding="16,0,8,0" Background="#18FFFFFF">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--
                拖动区只覆盖左侧（标题文本 + 空白）：右侧按钮留在普通客户区，
                不经过系统标题栏的交互穿透——那种穿透在快速点击后会失效
                （2026-10-01：切页点快了所有按钮没反应，即由此而来）。
            -->
            <Border x:Name="ManagerDragRegion" Background="Transparent" />
            <TextBlock Text="鹿米便笺"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="#FF403747" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                <Button x:Name="NewNoteButton"
                        Style="{StaticResource IconButtonStyle}"
                        Click="OnNewNoteClick"
                        ToolTipService.ToolTip="新建便笺">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                </Button>
                <Button x:Name="SettingsButton"
                        Style="{StaticResource IconButtonStyle}"
                        Click="OnSettingsPageClick"
                        ToolTipService.ToolTip="设置">
                    <FontIcon Glyph="&#xE713;" FontSize="14" />
                </Button>
                <Button x:Name="TrashButton"
                        Style="{StaticResource IconButtonStyle}"
                        Click="OnTrashPageClick"
                        ToolTipService.ToolTip="回收站">
                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                </Button>
                <Button x:Name="CloseButton"
                        Style="{StaticResource IconButtonStyle}"
                        Click="OnHideClick"
                        ToolTipService.ToolTip="隐藏列表">
                    <FontIcon Glyph="&#xE8BB;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- 页面容器：三个页面由 code-behind 构造并叠放，切页只改 Visibility（保住页面状态）。 -->
        <Grid x:Name="PageHost" Grid.Row="1" />

        <!-- 右下角计数：无筛选时是便签总数，搜索/筛选后是"命中数/总数"。 -->
        <Border Grid.Row="2" Background="#18FFFFFF" Padding="16,0">
            <TextBlock HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="#FF75697C"
                       Text="{x:Bind ViewModel.CountText, Mode=OneWay}" />
        </Border>

        <!--
            托盘控件必须挂在窗口的可视化树里：库内部的通知消息处理与菜单展开
            都经它的 DispatcherQueue 调度。悬空 new 出来的实例会出现
            「图标在、点了全都没反应」。管理器是常驻窗口（关闭只是隐藏），
            是它最合适的宿主；管理器没显示时由 TrayIconService 手动 ForceCreate。
        -->
        <tb:TaskbarIcon x:Name="TrayIcon" />
    </Grid>
</Window>
