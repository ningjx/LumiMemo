<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="LumiMemo.WinUI.ManagerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tb="using:H.NotifyIcon"
    Title="LumiMemo 便笺列表">

    <Grid x:Name="Root" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="ManagerTitleBar" Padding="16,0,8,0" Background="#18FFFFFF">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="鹿米便笺"
                       VerticalAlignment="Center"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="#FF403747" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                <Button Width="36" Height="30" Content="＋" Click="OnNewNoteClick"
                        Background="Transparent" BorderBrush="Transparent"
                        ToolTipService.ToolTip="新建便笺" />
                <Button Width="36" Height="30" Content="⚙" Click="OnLlmSettingsClick"
                        Background="Transparent" BorderBrush="Transparent"
                        ToolTipService.ToolTip="自动标题设置" />
                <Button Padding="10,0" Height="30" Content="回收站" Click="OnTrashClick"
                        Background="Transparent" BorderBrush="Transparent"
                        ToolTipService.ToolTip="回收站" />
                <Button Width="36" Height="30" Content="×" Click="OnHideClick"
                        Background="Transparent" BorderBrush="Transparent"
                        ToolTipService.ToolTip="隐藏列表" />
            </StackPanel>
        </Grid>

        <TextBox x:Name="SearchBox"
                 Grid.Row="1"
                 Margin="14,12,14,8"
                 PlaceholderText="搜索便笺"
                 TextChanged="OnSearchTextChanged" />

        <ListView x:Name="NotesList"
                  Grid.Row="2"
                  Margin="8,0,8,10"
                  ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                  IsItemClickEnabled="True"
                  ItemClick="OnNoteItemClick"
                  SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="10,8" MinHeight="62">
                        <Grid.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="打开" Click="OnItemOpenMenuClick" />
                                <MenuFlyoutItem Text="删除" Click="OnItemDeleteMenuClick" />
                            </MenuFlyout>
                        </Grid.ContextFlyout>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Title}"
                                       FontWeight="SemiBold"
                                       Foreground="#FF403747"
                                       TextTrimming="CharacterEllipsis" />
                            <ProgressRing Grid.Column="1" Width="16" Height="16"
                                          Margin="8,0,0,0" IsActive="{Binding IsGenerating}"
                                          Visibility="{Binding ProgressVisibility}" />
                        </Grid>
                        <TextBlock Grid.Row="1"
                                   Margin="0,4,0,0"
                                   Text="{Binding Content}"
                                   Foreground="#FF75697C"
                                   MaxLines="2"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="Wrap" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!--
            托盘控件必须挂在窗口的可视化树里：库内部的通知消息处理与菜单展开
            都经它的 DispatcherQueue 调度。悬空 new 出来的实例会出现
            「图标在、点了全都没反应」。管理器是常驻窗口（关闭只是隐藏），
            是它最合适的宿主；管理器没显示时由 TrayIconService 手动 ForceCreate。
        -->
        <tb:TaskbarIcon x:Name="TrayIcon" />
    </Grid>
</Window>
