<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="LumiMemo.WinUI.TrashWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="LumiMemo 回收站">

    <Grid x:Name="Root" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="52" />
        </Grid.RowDefinitions>

        <Grid x:Name="TrashTitleBar" Padding="16,0,8,0" Background="#18FFFFFF">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="回收站"
                       VerticalAlignment="Center"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="#FF403747" />
            <Button Grid.Column="1" Width="36" Height="30" Content="×" Click="OnHideClick"
                    Background="Transparent" BorderBrush="Transparent"
                    ToolTipService.ToolTip="关闭" />
        </Grid>

        <Grid Grid.Row="1">
            <ListView x:Name="TrashList"
                      Margin="8,8,8,8"
                      ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                      SelectionMode="Single"
                      SelectionChanged="OnSelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="10,8" MinHeight="56">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding Title}"
                                       FontWeight="SemiBold"
                                       Foreground="#FF403747"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Row="1"
                                       Margin="0,4,0,0"
                                       Text="{Binding DeletedAtText}"
                                       FontSize="12"
                                       Foreground="#FF75697C" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock x:Name="EmptyHint"
                       Text="回收站是空的"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="#FF75697C"
                       Visibility="Collapsed" />
        </Grid>

        <Border Grid.Row="2" Background="#18FFFFFF" Padding="10,0">
            <StackPanel Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="RestoreButton" Content="恢复" Click="OnRestoreClick" IsEnabled="False" />
                <Button x:Name="PurgeButton" Content="彻底删除" Click="OnPurgeClick" IsEnabled="False" />
                <Button x:Name="PurgeAllButton" Content="清空回收站" Click="OnPurgeAllClick" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
