<?xml version="1.0" encoding="utf-8" ?>
<!--
    文字底色取色器的"滑块层"：铺满窗口的覆盖层，只有一个滑块元素。
    色带本体**不在**这里——它插在工具栏里（宿主传进来），展开时右侧按钮由占位块推开；
    这里只负责把"那个圆角方块"滑到色带上、并跟随拖拽。
    位置一律用 TranslateTransform 驱动（Canvas.Left/Top 不能做动画）。
    注意：滑块必须设 Background 才既显色又参与命中测试（在 code-behind 里设）。
-->
<UserControl
    x:Class="LumiMemo.WinUI.Controls.HighlightPicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Canvas x:Name="Layer" Visibility="Collapsed">
        <!-- 色带周边的透明命中带：细带只有 6dip 高，按视觉位置点很容易点空（点空就走"点别处＝取消"，
             颜色没改就收起了）。这一段（带子左右各留一点、上下各留一圈）都算"点在色带上"。
             务必给 Background：没有画刷的 Border 不参与命中测试。 -->
        <Border x:Name="HitZone"
                Background="Transparent"
                Visibility="Collapsed">
            <Border.RenderTransform>
                <TranslateTransform x:Name="HitZoneShift" />
            </Border.RenderTransform>
        </Border>

        <!-- 滑块＝工具栏上那个圆角方块：展开期间由这里接管（方块本身隐藏，视觉上就是"它滑过去了"）。
             元素尺寸＝**收起**尺寸，与工具栏上的方块一致（见 .xaml.cs 的常量）；两者对不上会跳一下。
             变换顺序必须先缩放后平移，且原点在中心——反过来写的话平移量会被缩放放大。 -->
        <Border x:Name="Knob"
                Width="16"
                Height="16"
                CornerRadius="4"
                BorderBrush="#8075697C"
                BorderThickness="1"
                Opacity="0"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="KnobScale" />
                    <TranslateTransform x:Name="KnobShift" />
                </TransformGroup>
            </Border.RenderTransform>
        </Border>
    </Canvas>
</UserControl>
