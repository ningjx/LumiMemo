<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="LumiMemo.WinUI.Controls.HighlightPicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsHitTestVisible="False">

    <Canvas x:Name="Layer" Visibility="Collapsed">
        <Canvas x:Name="Track">
            <Canvas.RenderTransform>
                <TranslateTransform x:Name="TrackShift" />
            </Canvas.RenderTransform>
            <Border x:Name="Strip"
                    CornerRadius="3"
                    BorderBrush="#8075697C"
                    BorderThickness="1">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="StripScale" />
                </Border.RenderTransform>
            </Border>
            <Border x:Name="Knob"
                    Style="{StaticResource LumiToolbarSwatchStyle}">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="KnobShift" />
                </Border.RenderTransform>
            </Border>
        </Canvas>
    </Canvas>
</UserControl>
