<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="LumiMemo.WinUI.Controls.HeadingPicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsHitTestVisible="False">

    <Canvas x:Name="Layer" Visibility="Collapsed">
        <StackPanel Orientation="Horizontal">
            <StackPanel.RenderTransform>
                <TranslateTransform x:Name="StripShift" />
            </StackPanel.RenderTransform>
            <Grid x:Name="Choice1">
                <Grid Style="{StaticResource LumiHeadingFaceStyle}">
                    <Border x:Name="Outline1" Opacity="0" Style="{StaticResource LumiToolbarSwatchStyle}" />
                    <TextBlock Text="1" Style="{StaticResource LumiDigitStyle}" />
                </Grid>
            </Grid>
            <Grid x:Name="Choice2">
                <Grid Style="{StaticResource LumiHeadingFaceStyle}">
                    <Border x:Name="Outline2" Opacity="0" Style="{StaticResource LumiToolbarSwatchStyle}" />
                    <TextBlock Text="2" Style="{StaticResource LumiDigitStyle}" />
                </Grid>
            </Grid>
            <Grid x:Name="Choice3">
                <Grid Style="{StaticResource LumiHeadingFaceStyle}">
                    <Border x:Name="Outline3" Opacity="0" Style="{StaticResource LumiToolbarSwatchStyle}" />
                    <TextBlock Text="3" Style="{StaticResource LumiDigitStyle}" />
                </Grid>
            </Grid>
        </StackPanel>
    </Canvas>
</UserControl>
