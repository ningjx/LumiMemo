<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="LumiMemo.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:LumiMemo.WinUI.Controls"
    Title="LumiMemo">

    <Grid x:Name="Root" Background="Transparent" PreviewKeyDown="OnRootPreviewKeyDown">
    <Grid.Resources>
        <!--
            这十条是**窗口级**的主题键覆盖：把玻璃窗口上的按钮底色/描边换成"白色叠加"那一套。
            留在窗口里（不搬去 App 级）——搬上去会把管理器与对话框的常规按钮一起改掉。
            具名样式（GlassButtonStyle 等）已搬去 Theme/LumiTokens.xaml。
        -->
        <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#14FFFFFF" />
        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#24FFFFFF" />
        <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#58FFFFFF" />
        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#78FFFFFF" />
        <SolidColorBrush x:Key="ToggleButtonBackground" Color="Transparent" />
        <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#14FFFFFF" />
        <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#24FFFFFF" />
        <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#20FFFFFF" />
        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#2AFFFFFF" />
        <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="Transparent" />
        <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="#58FFFFFF" />
        <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="#78FFFFFF" />
        <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="#68FFFFFF" />
    </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="44" />
        </Grid.RowDefinitions>

        <Border x:Name="TitleBarHost"
                Grid.Row="0"
                Background="#18FFFFFF">
            <Grid x:Name="TitleBarGrid" Padding="14,0,7,0" SizeChanged="OnTitleBarSizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 标题按布局居中，空间不足时在进度圈和刷新按钮前以省略号收尾。 -->
                <Grid x:Name="TitleArea">
                    <TextBlock x:Name="TitleText"
                               Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               UseLayoutRounding="True"
                               FontWeight="SemiBold"
                               Foreground="#FF403747" />
                    <StackPanel x:Name="TitleOverlay"
                                Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                        <ProgressRing x:Name="TitleProgress"
                                      Width="16" Height="16" Margin="6,0,0,0"
                                      VerticalAlignment="Center"
                                      IsActive="{x:Bind ViewModel.IsTitleGenerating, Mode=OneWay}"
                                      Visibility="{x:Bind ToVisibility(ViewModel.IsTitleGenerating), Mode=OneWay}" />
                        <Button x:Name="RefreshTitleButton"
                                Width="26" Height="26" Margin="3,0,3,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource GlassButtonStyle}"
                                IsEnabled="{x:Bind ViewModel.CanRegenerateTitle, Mode=OneWay}"
                                Click="OnRefreshTitleClick"
                                ToolTipService.ToolTip="重新生成标题">
                            <FontIcon Style="{StaticResource LumiChromeIconStyle}" Glyph="&#xE0AA;" />
                        </Button>
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="ToolsPanel" Grid.Column="1" Orientation="Horizontal" Spacing="3"
                            VerticalAlignment="Center">
                    <Button x:Name="NewNoteButton"
                            Style="{StaticResource LumiChromeButtonStyle}"
                            VerticalAlignment="Center"
                            Click="OnNewNoteClick"
                            ToolTipService.ToolTip="新建便笺">
                        <FontIcon Style="{StaticResource LumiChromeIconStyle}" Glyph="&#xF56D;" />
                    </Button>
                    <ToggleButton x:Name="PinButton"
                                  Style="{StaticResource LumiChromeToggleStyle}"
                                  VerticalAlignment="Center"
                                  IsChecked="{x:Bind ViewModel.IsTopMost, Mode=TwoWay}"
                                  ToolTipService.ToolTip="置顶">
                        <FontIcon Style="{StaticResource LumiChromeIconStyle}" Glyph="&#xF600;" />
                    </ToggleButton>
                    <Button x:Name="DeleteNoteButton"
                            Style="{StaticResource LumiChromeButtonStyle}"
                            VerticalAlignment="Center"
                            Click="OnDeleteNoteClick"
                            ToolTipService.ToolTip="删除便签">
                        <FontIcon Style="{StaticResource LumiChromeIconStyle}" Glyph="&#xE47B;" />
                    </Button>
                    <Button x:Name="CloseButton"
                            Style="{StaticResource LumiChromeButtonStyle}"
                            VerticalAlignment="Center"
                            Click="OnCloseClick"
                            ToolTipService.ToolTip="关闭">
                        <FontIcon Style="{StaticResource LumiChromeIconStyle}" Glyph="&#xF368;" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="EditorHost" Grid.Row="1" />

        <Border x:Name="ToolbarBar"
                Grid.Row="2"
                Background="#18FFFFFF"
                Padding="8,0,10,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                    <StackPanel x:Name="HeadingLeftGroup" Orientation="Horizontal" Spacing="3">
                        <StackPanel x:Name="HighlightLeftGroup" Orientation="Horizontal" Spacing="3">
                            <Button Style="{StaticResource LumiToolbarButtonStyle}" Click="OnBoldClick"
                                    AutomationProperties.Name="粗体" ToolTipService.ToolTip="粗体">
                                <Canvas Style="{StaticResource LumiToolbarGlyphBoxStyle}">
                                    <Path Style="{StaticResource LumiToolbarStrokeStyle}" StrokeThickness="2"
                                          Data="M5,17 V3 H10.5 C13.2,3 14.7,4.4 14.7,6.5 C14.7,8.6 13.2,10 10.5,10 H5 M10.5,10 C13.5,10 15,11.4 15,13.5 C15,15.6 13.5,17 10.5,17 H5" />
                                </Canvas>
                            </Button>
                            <Button Style="{StaticResource LumiToolbarButtonStyle}" Click="OnItalicClick"
                                    AutomationProperties.Name="斜体" ToolTipService.ToolTip="斜体">
                                <Canvas Style="{StaticResource LumiToolbarGlyphBoxStyle}">
                                    <Path Style="{StaticResource LumiToolbarStrokeStyle}"
                                          Data="M8,3 H16 M4,17 H12 M12,3 L8,17" />
                                </Canvas>
                            </Button>
                            <Button Style="{StaticResource LumiToolbarButtonStyle}" Click="OnUnderlineClick"
                                    AutomationProperties.Name="下划线" ToolTipService.ToolTip="下划线">
                                <Canvas Style="{StaticResource LumiToolbarGlyphBoxStyle}">
                                    <Path Style="{StaticResource LumiToolbarStrokeStyle}"
                                          Data="M5,3 V9 C5,11.9 7,13.5 10,13.5 C13,13.5 15,11.9 15,9 V3 M4,17 H16" />
                                </Canvas>
                            </Button>
                            <Button Style="{StaticResource LumiToolbarButtonStyle}" Click="OnStrikeClick"
                                    AutomationProperties.Name="删除线" ToolTipService.ToolTip="删除线">
                                <Canvas Style="{StaticResource LumiToolbarGlyphBoxStyle}">
                                    <Path Style="{StaticResource LumiToolbarStrokeStyle}"
                                          Data="M14.5,4.4 C13.4,3.4 12,3 10.1,3 C7.3,3 5.6,4.3 5.6,6.2 C5.6,8 7,8.8 9.3,9.4 M10.7,10.6 C13,11.2 14.4,12 14.4,13.8 C14.4,15.7 12.7,17 9.9,17 C8,17 6.5,16.5 5.4,15.5 M3,10 H17" />
                                </Canvas>
                            </Button>
                            <Rectangle Width="1" Height="18" Margin="3,0" Fill="#5075697C" />
                            <ToggleButton x:Name="BulletButton" Style="{StaticResource LumiToolbarToggleStyle}"
                                          Click="OnBulletClick" AutomationProperties.Name="分点列表"
                                          ToolTipService.ToolTip="分点列表（再按一次取消；Esc 也行）">
                                <Canvas Style="{StaticResource LumiToolbarGlyphBoxStyle}">
                                    <Path Fill="{StaticResource LumiIconInk}" Stretch="None">
                                        <Path.Data>
                                            <GeometryGroup>
                                                <EllipseGeometry Center="4,5" RadiusX="1.25" RadiusY="1.25" />
                                                <EllipseGeometry Center="4,10" RadiusX="1.25" RadiusY="1.25" />
                                                <EllipseGeometry Center="4,15" RadiusX="1.25" RadiusY="1.25" />
                                            </GeometryGroup>
                                        </Path.Data>
                                    </Path>
                                    <Path Style="{StaticResource LumiToolbarStrokeStyle}"
                                          Data="M8,5 H16.5 M8,10 H16.5 M8,15 H16.5" />
                                </Canvas>
                            </ToggleButton>
                            <ToggleButton x:Name="TodoButton" Style="{StaticResource LumiToolbarToggleStyle}"
                                          Click="OnTodoClick" AutomationProperties.Name="待办勾选"
                                          ToolTipService.ToolTip="待办勾选（再按一次取消；Esc 也行）">
                                <Canvas Style="{StaticResource LumiToolbarGlyphBoxStyle}">
                                    <Border Style="{StaticResource LumiToolbarSwatchStyle}" Canvas.Left="2" Canvas.Top="2" />
                                    <Path Style="{StaticResource LumiToolbarStrokeStyle}" Data="M6.5,10 L9,12.5 L13.5,7.5" />
                                </Canvas>
                            </ToggleButton>
                            <Rectangle Width="1" Height="18" Margin="3,0" Fill="#5075697C" />
                        </StackPanel>
                        <controls:ToolbarDragButton x:Name="HighlightButton"
                                                      Style="{StaticResource LumiToolbarButtonStyle}"
                                                      AutomationProperties.Name="文字底色"
                                                      Click="OnHighlightClick">
                            <Border x:Name="HighlightButtonFill"
                                    Style="{StaticResource LumiToolbarSwatchStyle}" />
                        </controls:ToolbarDragButton>
                    </StackPanel>
                    <StackPanel x:Name="HighlightRightGroup" Orientation="Horizontal" Spacing="3">
                        <Rectangle x:Name="HeadingLeftDivider"
                                   Width="1" Height="18" Margin="3,0,0,0" Fill="#5075697C" />
                        <controls:ToolbarDragButton x:Name="HeadingButton"
                                                    Style="{StaticResource LumiToolbarButtonStyle}"
                                                    AutomationProperties.Name="字号"
                                                    Click="OnHeadingClick">
                            <Grid x:Name="HeadingFace" Style="{StaticResource LumiHeadingFaceStyle}">
                                <Border Style="{StaticResource LumiToolbarSwatchStyle}" />
                                <TextBlock x:Name="HeadingFaceLevel"
                                           Text="2"
                                           Style="{StaticResource LumiDigitStyle}" />
                            </Grid>
                        </controls:ToolbarDragButton>
                    </StackPanel>
                </StackPanel>
                <StackPanel x:Name="ToolbarStatus" Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="4"
                            VerticalAlignment="Center">
                    <!-- 右下角保存状态：转圈（保存中）/ 对勾（已保存）/ 警示（失败或临时提示）。
                         有临时提示时以提示文案为准（提示多半是失败信息，不能只藏在 Tooltip 里）。
                         图标与显隐由 code-behind 的 UpdateStatusVisuals 统一管，完整文案进 Tooltip。 -->
                    <ProgressRing x:Name="StatusProgress"
                                  Width="14" Height="14"
                                  IsActive="False"
                                  Visibility="Collapsed" />
                    <FontIcon x:Name="StatusIcon"
                              Style="{StaticResource LumiChromeIconStyle}"
                              Glyph="&#xE305;"
                              Foreground="#FF75697C" />
                    <TextBlock x:Name="StatusCountText"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="#FF75697C" />
                    <TextBlock x:Name="StatusHintText"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="#FF75697C"
                               Visibility="Collapsed" />
                </StackPanel>
            </Grid>
        </Border>

        <controls:HighlightPicker x:Name="HighlightPickerLayer" Grid.RowSpan="3" />
        <controls:HeadingPicker x:Name="HeadingPickerLayer" Grid.RowSpan="3" />

    </Grid>
</Window>
