<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="LumiMemo.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:LumiMemo.WinUI.Controls"
    Title="LumiMemo">

    <Grid x:Name="Root" Background="Transparent" PreviewKeyDown="OnRootPreviewKeyDown">
    <Grid.Resources>
        <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#14FFFFFF" />
        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#24FFFFFF" />
        <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#58FFFFFF" />
        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#78FFFFFF" />
        <SolidColorBrush x:Key="ToggleButtonBackground" Color="Transparent" />
        <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#14FFFFFF" />
        <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#24FFFFFF" />
        <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#20FFFFFF" />
        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#2AFFFFFF" />
        <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="Transparent" />
        <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="#58FFFFFF" />
        <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="#78FFFFFF" />
        <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="#68FFFFFF" />

        <Style x:Key="GlassButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style x:Key="GlassToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="44" />
        </Grid.RowDefinitions>

        <Border x:Name="TitleBarHost"
                Grid.Row="0"
                Background="#18FFFFFF">
            <Grid x:Name="TitleBarGrid" Padding="14,0,7,0" SizeChanged="OnTitleBarSizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--
                    标题区两层：文字在下层按自然宽度铺、不做按字裁剪；
                    进度圈 + 刷新按钮是上层遮罩，位置 = min(文字自然宽, 限位)，
                    随窗口宽度连续移动（拖动窗口时线性顺滑、不按字跳变）。
                    缩到装不下时，文字在遮罩左缘前用不透明度蒙版渐隐收尾（见 code-behind）。
                -->
                <Grid x:Name="TitleArea">
                    <TextBlock x:Name="TitleText"
                               Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="#FF403747">
                        <!--
                            标题文字的视觉微调值：VerticalAlignment=Center 对齐的是行框，
                            中文字体的行框底部含拉丁下伸空间、汉字用不到，光学上会差一点。
                            0=不偏移，负数=往上提。想自己调就改这个 Y。
                        -->
                        <TextBlock.RenderTransform>
                            <TranslateTransform Y="-0.5" />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <StackPanel x:Name="TitleOverlay"
                                Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                        <ProgressRing x:Name="TitleProgress"
                                      Width="16" Height="16" Margin="6,0,0,0"
                                      VerticalAlignment="Center"
                                      IsActive="{x:Bind ViewModel.IsTitleGenerating, Mode=OneWay}"
                                      Visibility="{x:Bind ToVisibility(ViewModel.IsTitleGenerating), Mode=OneWay}" />
                        <Button x:Name="RefreshTitleButton"
                                Width="26" Height="26" Margin="3,0,3,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource GlassButtonStyle}"
                                IsEnabled="{x:Bind ViewModel.CanRegenerateTitle, Mode=OneWay}"
                                Click="OnRefreshTitleClick"
                                ToolTipService.ToolTip="重新生成标题">
                            <FontIcon FontFamily="{StaticResource LumiIconFont}" FontSize="{StaticResource LumiIconSizeChrome}" Glyph="&#xE0AA;" />
                        </Button>
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="ToolsPanel" Grid.Column="1" Orientation="Horizontal" Spacing="3"
                            VerticalAlignment="Center">
                    <Button x:Name="NewNoteButton"
                            Width="32" Height="30"
                            Style="{StaticResource GlassButtonStyle}"
                            VerticalAlignment="Center"
                            Click="OnNewNoteClick"
                            ToolTipService.ToolTip="新建便笺">
                        <FontIcon FontFamily="{StaticResource LumiIconFont}" FontSize="{StaticResource LumiIconSizeChrome}" Glyph="&#xF56D;" />
                    </Button>
                    <ToggleButton x:Name="PinButton"
                                  Style="{StaticResource GlassToggleButtonStyle}"
                                  Width="32" Height="30"
                                  VerticalAlignment="Center"
                                  IsChecked="{x:Bind ViewModel.IsTopMost, Mode=TwoWay}"
                                  ToolTipService.ToolTip="置顶">
                        <FontIcon FontFamily="{StaticResource LumiIconFont}" FontSize="{StaticResource LumiIconSizeChrome}" Glyph="&#xF600;" />
                    </ToggleButton>
                    <Button x:Name="DeleteNoteButton"
                            Width="32" Height="30"
                            Style="{StaticResource GlassButtonStyle}"
                            VerticalAlignment="Center"
                            Click="OnDeleteNoteClick"
                            ToolTipService.ToolTip="删除便签">
                        <FontIcon FontFamily="{StaticResource LumiIconFont}" FontSize="{StaticResource LumiIconSizeChrome}" Glyph="&#xE47B;" />
                    </Button>
                    <Button x:Name="CloseButton"
                            Width="32" Height="30"
                            Style="{StaticResource GlassButtonStyle}"
                            VerticalAlignment="Center"
                            Click="OnCloseClick"
                            ToolTipService.ToolTip="关闭">
                        <FontIcon FontFamily="{StaticResource LumiIconFont}" FontSize="{StaticResource LumiIconSizeChrome}" Glyph="&#xF368;" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="EditorHost" Grid.Row="1" />

        <Border x:Name="ToolbarBar"
                Grid.Row="2"
                Background="#18FFFFFF"
                Padding="8,0,10,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 色带：**排在按钮栏前面＝z 序在按钮底下**，左缘由取色器对齐到方块左缘、向右变长。
                     它常驻布局（收起＝宽 0 + 透明；别用 Visibility，Collapsed 的元素量不到有效坐标）。
                     它不占按钮栏的位置——"把右侧按钮推开"由 StackPanel 里的占位块负责。 -->
                <Border x:Name="HighlightStrip"
                        Width="0"
                        Opacity="0"
                        Height="6"
                        CornerRadius="3"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        BorderBrush="#8075697C"
                        BorderThickness="1">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0" />
                    </Border.Background>
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="HighlightStripShift" />
                    </Border.RenderTransform>
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                    <!-- 图标一律取自 Fluent UI System Icons（字体与尺寸见 App.xaml 的 LumiIconFont /
                         LumiIconSizeToolbar；名字→码位见 LumiIcons.cs）。工具栏统一 20px 字形。 -->
                    <Button Style="{StaticResource GlassButtonStyle}" Width="30" Height="30" Click="OnBoldClick" ToolTipService.ToolTip="粗体">
                        <FontIcon FontFamily="{StaticResource LumiIconFont}" FontSize="{StaticResource LumiIconSizeToolbar}" Glyph="&#xF7A4;" />
                    </Button>
                    <Button Style="{StaticResource GlassButtonStyle}" Width="30" Height="30" Click="OnItalicClick" ToolTipService.ToolTip="斜体">
                        <FontIcon FontFamily="{StaticResource LumiIconFont}" FontSize="{StaticResource LumiIconSizeToolbar}" Glyph="&#xF7F4;" />
                    </Button>
                    <Button Style="{StaticResource GlassButtonStyle}" Width="30" Height="30" Click="OnUnderlineClick" ToolTipService.ToolTip="下划线">
                        <FontIcon FontFamily="{StaticResource LumiIconFont}" FontSize="{StaticResource LumiIconSizeToolbar}" Glyph="&#xF80A;" />
                    </Button>
                    <Button Style="{StaticResource GlassButtonStyle}" Width="30" Height="30" Click="OnStrikeClick" ToolTipService.ToolTip="删除线">
                        <FontIcon FontFamily="{StaticResource LumiIconFont}" FontSize="{StaticResource LumiIconSizeToolbar}" Glyph="&#xED5F;" />
                    </Button>
                    <Rectangle Width="1" Height="18" Margin="3,0" Fill="#5075697C" />
                    <ToggleButton x:Name="BulletButton" Style="{StaticResource GlassToggleButtonStyle}" Width="30" Height="30" Click="OnBulletClick" ToolTipService.ToolTip="分点列表（再按一次取消；Esc 也行）">
                        <FontIcon FontFamily="{StaticResource LumiIconFont}" FontSize="{StaticResource LumiIconSizeToolbar}" Glyph="&#xF0290;" />
                    </ToggleButton>
                    <ToggleButton x:Name="TodoButton" Style="{StaticResource GlassToggleButtonStyle}" Width="30" Height="30" Click="OnTodoClick" ToolTipService.ToolTip="待办勾选（再按一次取消；Esc 也行）">
                        <FontIcon FontFamily="{StaticResource LumiIconFont}" FontSize="{StaticResource LumiIconSizeToolbar}" Glyph="&#xF28D;" />
                    </ToggleButton>
                    <Rectangle Width="1" Height="18" Margin="3,0" Fill="#5075697C" />
                    <!-- 文字底色：圆角方块就是按钮本体（底色＝当前色）。
                         左键＝把当前色刷到选中文字；右键＝展开色带取色（HighlightPicker）。 -->
                    <Button x:Name="HighlightButton"
                            Style="{StaticResource GlassButtonStyle}"
                            Width="30" Height="30"
                            Click="OnHighlightClick"
                            RightTapped="OnHighlightRightTapped"
                            ToolTipService.ToolTip="文字底色（左键＝用当前色刷选中文字；右键＝展开色带取色）">
                        <Border x:Name="HighlightButtonFill"
                                Width="18" Height="18"
                                CornerRadius="5"
                                BorderBrush="#8075697C"
                                BorderThickness="1" />
                    </Button>
                    <!-- 展开占位：与色带同步变宽，把右侧按钮推开（色带本体在按钮底下的图层里，只负责画）。
                         负外边距抵消两端的 Spacing：收起时不占位，展开时的位移正好等于宽度。 -->
                    <Border x:Name="HighlightStripSpacer"
                            Width="0"
                            Margin="-3,0,-3,0" />
                    <Rectangle Width="1" Height="18" Margin="3,0" Fill="#5075697C" />
                    <ToggleButton x:Name="Heading1Button" Style="{StaticResource GlassToggleButtonStyle}" Width="30" Height="30" Click="OnHeading1Click" ToolTipService.ToolTip="标题 1">
                        <FontIcon FontFamily="{StaticResource LumiIconFont}" FontSize="{StaticResource LumiIconSizeToolbar}" Glyph="&#xF7EF;" />
                    </ToggleButton>
                    <ToggleButton x:Name="Heading2Button" Style="{StaticResource GlassToggleButtonStyle}" Width="30" Height="30" Click="OnHeading2Click" ToolTipService.ToolTip="标题 2">
                        <FontIcon FontFamily="{StaticResource LumiIconFont}" FontSize="{StaticResource LumiIconSizeToolbar}" Glyph="&#xF7F0;" />
                    </ToggleButton>
                    <ToggleButton x:Name="Heading3Button" Style="{StaticResource GlassToggleButtonStyle}" Width="30" Height="30" Click="OnHeading3Click" ToolTipService.ToolTip="标题 3">
                        <FontIcon FontFamily="{StaticResource LumiIconFont}" FontSize="{StaticResource LumiIconSizeToolbar}" Glyph="&#xF7F1;" />
                    </ToggleButton>
                </StackPanel>
                <TextBlock x:Name="StatusText"
                           Grid.Column="1"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="#FF75697C"
                           Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
            </Grid>
        </Border>

        <!-- 文字底色取色器（展开式色带）：铺满窗口的覆盖层，空白处不吃指针（见控件里的纪律说明）；
             放在最后＝z 序最高，色带压在编辑区之上。 -->
        <controls:HighlightPicker x:Name="HighlightPickerLayer" Grid.RowSpan="3" />

    </Grid>
</Window>
