<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="LumiMemo.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="LumiMemo">

    <Grid x:Name="Root" Background="Transparent">
    <Grid.Resources>
        <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#14FFFFFF" />
        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#24FFFFFF" />
        <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#58FFFFFF" />
        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#78FFFFFF" />
        <SolidColorBrush x:Key="ToggleButtonBackground" Color="Transparent" />
        <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#14FFFFFF" />
        <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#24FFFFFF" />
        <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#20FFFFFF" />
        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#2AFFFFFF" />
        <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="Transparent" />
        <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="#58FFFFFF" />
        <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="#78FFFFFF" />
        <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="#68FFFFFF" />

        <Style x:Key="GlassButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style x:Key="GlassToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="44" />
        </Grid.RowDefinitions>

        <Border x:Name="TitleBarHost"
                Grid.Row="0"
                Background="#18FFFFFF">
            <Grid Padding="14,0,7,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TitleText"
                               Text="LumiMemo"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="#FF403747"
                               TextTrimming="CharacterEllipsis" />
                    <ProgressRing x:Name="TitleProgress" Grid.Column="1"
                                  Width="16" Height="16" Margin="6,0,0,0"
                                  VerticalAlignment="Center"
                                  IsActive="False" Visibility="Collapsed" />
                </Grid>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3">
                    <ToggleButton x:Name="PinButton"
                                  Style="{StaticResource GlassToggleButtonStyle}"
                                  Width="32" Height="30"
                                  VerticalAlignment="Center"
                                  Click="OnPinClick"
                                  ToolTipService.ToolTip="置顶"
                                  Content="↑" />
                    <Button Width="32" Height="30"
                            Style="{StaticResource GlassButtonStyle}"
                            VerticalAlignment="Center"
                            Click="OnCloseClick"
                            ToolTipService.ToolTip="关闭"
                            Content="×" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="EditorHost" Grid.Row="1" />

        <Border Grid.Row="2"
                Background="#18FFFFFF"
                Padding="8,0,10,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                    <Button Style="{StaticResource GlassButtonStyle}" Width="30" Height="30" Click="OnBoldClick" ToolTipService.ToolTip="粗体">
                        <TextBlock Text="B" FontSize="16" FontWeight="Bold" />
                    </Button>
                    <Button Style="{StaticResource GlassButtonStyle}" Width="30" Height="30" Click="OnItalicClick" ToolTipService.ToolTip="斜体">
                        <TextBlock Text="I" FontSize="16" FontStyle="Italic" />
                    </Button>
                    <Button Style="{StaticResource GlassButtonStyle}" Width="30" Height="30" Click="OnUnderlineClick" ToolTipService.ToolTip="下划线">
                        <TextBlock Text="U" FontSize="15" TextDecorations="Underline" />
                    </Button>
                    <Button Style="{StaticResource GlassButtonStyle}" Width="30" Height="30" Click="OnStrikeClick" ToolTipService.ToolTip="删除线">
                        <TextBlock Text="S" FontSize="15" TextDecorations="Strikethrough" />
                    </Button>
                    <Rectangle Width="1" Height="18" Margin="3,0" Fill="#5075697C" />
                    <Button Style="{StaticResource GlassButtonStyle}" Width="34" Height="30" Click="OnInsertImageClick" ToolTipService.ToolTip="插入图片" Content="▧" />
                </StackPanel>
                <TextBlock x:Name="StatusText"
                           Grid.Column="1"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="#FF75697C"
                           Text="已保存 · 0 字" />
            </Grid>
        </Border>

    </Grid>
</Window>

