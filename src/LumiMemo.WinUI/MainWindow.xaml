<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="LumiMemo.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:LumiMemo.WinUI.Controls"
    Title="LumiMemo">

    <Grid x:Name="Root" Background="Transparent" PreviewKeyDown="OnRootPreviewKeyDown">
    <Grid.Resources>
        <!--
            这十条是**窗口级**的主题键覆盖：把玻璃窗口上的按钮底色/描边换成"白色叠加"那一套。
            留在窗口里（不搬去 App 级）——搬上去会把管理器与对话框的常规按钮一起改掉。
            具名样式（GlassButtonStyle 等）已搬去 Theme/LumiTokens.xaml。
        -->
        <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#14FFFFFF" />
        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#24FFFFFF" />
        <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#58FFFFFF" />
        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#78FFFFFF" />
        <SolidColorBrush x:Key="ToggleButtonBackground" Color="Transparent" />
        <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#14FFFFFF" />
        <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#24FFFFFF" />
        <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#20FFFFFF" />
        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#2AFFFFFF" />
        <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="Transparent" />
        <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="#58FFFFFF" />
        <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="#78FFFFFF" />
        <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="#68FFFFFF" />
    </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="44" />
        </Grid.RowDefinitions>

        <Border x:Name="TitleBarHost"
                Grid.Row="0"
                Background="#18FFFFFF">
            <Grid x:Name="TitleBarGrid" Padding="14,0,7,0" SizeChanged="OnTitleBarSizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--
                    标题区两层：文字在下层按自然宽度铺、不做按字裁剪；
                    进度圈 + 刷新按钮是上层遮罩，位置 = min(文字自然宽, 限位)，
                    随窗口宽度连续移动（拖动窗口时线性顺滑、不按字跳变）。
                    缩到装不下时，文字在遮罩左缘前用不透明度蒙版渐隐收尾（见 code-behind）。
                -->
                <Grid x:Name="TitleArea">
                    <TextBlock x:Name="TitleText"
                               Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="#FF403747">
                        <!--
                            标题文字的视觉微调值：VerticalAlignment=Center 对齐的是行框，
                            中文字体的行框底部含拉丁下伸空间、汉字用不到，光学上会差一点。
                            0=不偏移，负数=往上提。想自己调就改这个 Y。
                        -->
                        <TextBlock.RenderTransform>
                            <TranslateTransform Y="-0.5" />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <StackPanel x:Name="TitleOverlay"
                                Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                        <ProgressRing x:Name="TitleProgress"
                                      Width="16" Height="16" Margin="6,0,0,0"
                                      VerticalAlignment="Center"
                                      IsActive="{x:Bind ViewModel.IsTitleGenerating, Mode=OneWay}"
                                      Visibility="{x:Bind ToVisibility(ViewModel.IsTitleGenerating), Mode=OneWay}" />
                        <Button x:Name="RefreshTitleButton"
                                Width="26" Height="26" Margin="3,0,3,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource GlassButtonStyle}"
                                IsEnabled="{x:Bind ViewModel.CanRegenerateTitle, Mode=OneWay}"
                                Click="OnRefreshTitleClick"
                                ToolTipService.ToolTip="重新生成标题">
                            <FontIcon Style="{StaticResource LumiChromeIconStyle}" Glyph="&#xE0AA;" />
                        </Button>
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="ToolsPanel" Grid.Column="1" Orientation="Horizontal" Spacing="3"
                            VerticalAlignment="Center">
                    <Button x:Name="NewNoteButton"
                            Style="{StaticResource LumiChromeButtonStyle}"
                            VerticalAlignment="Center"
                            Click="OnNewNoteClick"
                            ToolTipService.ToolTip="新建便笺">
                        <FontIcon Style="{StaticResource LumiChromeIconStyle}" Glyph="&#xF56D;" />
                    </Button>
                    <ToggleButton x:Name="PinButton"
                                  Style="{StaticResource LumiChromeToggleStyle}"
                                  VerticalAlignment="Center"
                                  IsChecked="{x:Bind ViewModel.IsTopMost, Mode=TwoWay}"
                                  ToolTipService.ToolTip="置顶">
                        <FontIcon Style="{StaticResource LumiChromeIconStyle}" Glyph="&#xF600;" />
                    </ToggleButton>
                    <Button x:Name="DeleteNoteButton"
                            Style="{StaticResource LumiChromeButtonStyle}"
                            VerticalAlignment="Center"
                            Click="OnDeleteNoteClick"
                            ToolTipService.ToolTip="删除便签">
                        <FontIcon Style="{StaticResource LumiChromeIconStyle}" Glyph="&#xE47B;" />
                    </Button>
                    <Button x:Name="CloseButton"
                            Style="{StaticResource LumiChromeButtonStyle}"
                            VerticalAlignment="Center"
                            Click="OnCloseClick"
                            ToolTipService.ToolTip="关闭">
                        <FontIcon Style="{StaticResource LumiChromeIconStyle}" Glyph="&#xF368;" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="EditorHost" Grid.Row="1" />

        <Border x:Name="ToolbarBar"
                Grid.Row="2"
                Background="#18FFFFFF"
                Padding="8,0,10,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 色带：**排在按钮栏前面＝z 序在按钮底下**，左缘由取色器对齐到方块左缘、向右变长。
                     它常驻布局（收起＝宽 0 + 透明；别用 Visibility，Collapsed 的元素量不到有效坐标）。
                     它不占按钮栏的位置——"把右侧按钮推开"由 StackPanel 里的占位块负责。 -->
                <Border x:Name="HighlightStrip"
                        Width="0"
                        Opacity="0"
                        Height="6"
                        CornerRadius="3"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        BorderBrush="#8075697C"
                        BorderThickness="1">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0" />
                    </Border.Background>
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="HighlightStripShift" />
                    </Border.RenderTransform>
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                    <!-- 图标一律取自 Fluent UI System Icons。字体/字号/墨迹微调/按钮尺寸都收在
                         Theme/LumiTokens.xaml 的具名样式里（名字→码位见 LumiIcons.cs）。 -->
                    <Button Style="{StaticResource LumiToolbarButtonStyle}" Click="OnBoldClick" ToolTipService.ToolTip="粗体">
                        <FontIcon Style="{StaticResource LumiToolbarIconStyle}" Glyph="&#xF7A4;" />
                    </Button>
                    <Button Style="{StaticResource LumiToolbarButtonStyle}" Click="OnItalicClick" ToolTipService.ToolTip="斜体">
                        <FontIcon Style="{StaticResource LumiToolbarIconStyle}" Glyph="&#xF7F4;" />
                    </Button>
                    <Button Style="{StaticResource LumiToolbarButtonStyle}" Click="OnUnderlineClick" ToolTipService.ToolTip="下划线">
                        <FontIcon Style="{StaticResource LumiToolbarIconStyle}" Glyph="&#xF80A;" />
                    </Button>
                    <Button Style="{StaticResource LumiToolbarButtonStyle}" Click="OnStrikeClick" ToolTipService.ToolTip="删除线">
                        <FontIcon Style="{StaticResource LumiToolbarIconStyle}" Glyph="&#xED5F;" />
                    </Button>
                    <Rectangle Width="1" Height="18" Margin="3,0" Fill="#5075697C" />
                    <ToggleButton x:Name="BulletButton" Style="{StaticResource LumiToolbarToggleStyle}" Click="OnBulletClick" ToolTipService.ToolTip="分点列表（再按一次取消；Esc 也行）">
                        <FontIcon Style="{StaticResource LumiToolbarIconStyle}" Glyph="&#xF0290;" />
                    </ToggleButton>
                    <ToggleButton x:Name="TodoButton" Style="{StaticResource LumiToolbarToggleStyle}" Click="OnTodoClick" ToolTipService.ToolTip="待办勾选（再按一次取消；Esc 也行）">
                        <FontIcon Style="{StaticResource LumiToolbarIconStyle}" Glyph="&#xF28D;" />
                    </ToggleButton>
                    <Rectangle Width="1" Height="18" Margin="3,0" Fill="#5075697C" />
                    <!-- 文字底色：圆角方块就是按钮本体（底色＝当前色）。
                         方块 16×16：与图标的墨迹（17dip）同一个量级。原来 18 是刻意大一圈，
                         2026-10-04 实机看着比图标重，收成一样大。
                         圆角 4＝**正文里待办勾选框的那条规则**（FlowDocumentRenderer：0.25 × 边长），
                         这样方块和正文里的勾选框看着是一套。
                         **改尺寸/圆角都要同步 HighlightPicker 的 CollapsedKnobSize 与 Knob 的圆角**
                         （滑块从它手里接管，对不上会在接管那一瞬间跳一下）。 -->
                    <Button x:Name="HighlightButton"
                            Style="{StaticResource LumiToolbarButtonStyle}"
                            Click="OnHighlightClick"
                            RightTapped="OnHighlightRightTapped"
                            ToolTipService.ToolTip="文字底色（左键＝用当前色刷选中文字；右键＝展开色带取色）">
            <Border x:Name="HighlightButtonFill" Margin="0,-1,0,0"
                                Width="16" Height="16"
                                CornerRadius="4"
                                BorderBrush="#8075697C"
                                BorderThickness="1" />
                    </Button>
                    <!-- 展开占位：与色带同步变宽，把右侧按钮推开（色带本体在按钮底下的图层里，只负责画）。
                         负外边距抵消两端的 Spacing：收起时不占位，展开时的位移正好等于宽度。 -->
                    <Border x:Name="HighlightStripSpacer"
                            Width="0"
                            Margin="-3,0,-3,0" />
                    <Rectangle Width="1" Height="18" Margin="3,0" Fill="#5075697C" />
                    <!-- 常用标题（2026-10-04 由三个按钮合并而来，且**全局保存**）：
                         面上＝H + **下角标**数字（H₂ 的读法，常用级别）；左键＝把它套用到光标所在块——
                         与合并前那三个按钮的逻辑一样（命令自带 toggle，再来一下即回正文）；
                         右键＝1/2/3 在 H 右边向右展开，点一个即改常用级别并收起（不动正文）。
                         这个级别与左边的文字底色一样跟着**应用**走（ToolbarPreferences → settings.json），
                         新建便签、重开程序都沿用。 -->
                    <Button x:Name="HeadingButton"
                            Style="{StaticResource LumiToolbarButtonStyle}"
                            Click="OnHeadingClick"
                            RightTapped="OnHeadingRightTapped"
                            ToolTipService.ToolTip="常用标题（左键＝选中文字则放大成该级字号／否则整段设为该级标题；右键＝改常用级别）">
                        <!-- 整块自动宽度：角标紧跟在 H 后面、沉到基线以下（下角标）。
                             这里这个是**看不见的占位**（Opacity 0）：它只干两件事——撑住 H 的位置、
                             以及让角标知道"收起时该停在哪儿"。看得见的那个角标是浮层上的
                             HeadingBadge（展开时它要飞出去，待在按钮里飞不出去）。
                             想更贴就把左边距往负调、想更沉就把下边距往负调；字号同理——都是光学值。 -->
                        <!-- 上移 1.2dip：H 的墨迹是 cap height，在行框里本来就偏下，跟图标和色块比会显得低。
                             这个 Margin 是**全额生效**的（实测；不是"居中打对折"）。 -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Margin="0,-3,0,0">
                            <!-- 19 是"重量"对齐值：旁边图标的墨迹有 17dip，而 H 的墨迹只有 0.7×字号，
                                 17 号只有 11.9dip（看着比图标小一圈）。 -->
                            <TextBlock Text="H" FontSize="19" FontWeight="SemiBold" />
                            <!-- 看不见的占位：撑住 H 的位置，并给角标当"收起时停在哪儿"的锚。
                                 字号**必须与角标、与选项里的数字一致（13）**：角标收起时就是它本身，
                                 不缩放——角标缩放动画的幅度 = 占位字号 ÷ 角标字号，这里相等就是 0。
                                 （想让收起的下角标更小，就把这个字号调小：缩放会自己回来。）
                                 最后一个 Margin 数是"底边距"（Bottom 对齐下精确生效，加大＝往上）：
                                 它把**看得见的那个数字**停在原来的位置（字号 11→13 后重心会上移，这里补掉）。 -->
                            <TextBlock x:Name="HeadingFaceLevelSlot"
                                       Text="2"
                                       Width="7"
                                       FontSize="13" FontWeight="SemiBold"
                                       TextAlignment="Center"
                                       VerticalAlignment="Bottom"
                                       Margin="1,0,0,-0.335"
                                       Opacity="0" />
                        </StackPanel>
                    </Button>
                    <!-- 选项帘子：宽 0 → 42 做动画，里面的按钮**原位**被逐段露出来（不是被压扁）。
                         必须配矩形裁剪——WinUI 没有 ClipToBounds，0 宽的外框照样把溢出的子元素画出来；
                         裁剪框随实际宽度走（见 code-behind 的 SizeChanged）。
                         与 H 贴多近由下面这个负外边距定（往 H 的右余白里塞）。
                         展开期间 H 不画自己的背景（见 code-behind 的 SetHeadingButtonActive）——
                         露出来的就是"H + 1/2/3"一整套，H 上再挂一圈悬停框就不成一体了。
                         选项自己被选中的那一刻：数字让位给飞过来的角标，同时亮起那个矮指示框。 -->
                    <Border x:Name="HeadingChoiceHost"
                            Width="0"
                            Margin="-14,0,0,0"
                            VerticalAlignment="Center"
                            SizeChanged="OnHeadingChoiceHostSizeChanged">
                        <Border.Clip>
                            <RectangleGeometry x:Name="HeadingChoiceClip" Rect="0,0,0,0" />
                        </Border.Clip>
                        <!-- 整排的高度不靠 Margin 调：由 code-behind 的 AlignHeadingChoicesWithSubscript
                             按实测把这一排对到"H 下角标"的高度上（角标飞过去于是**只走横向**）。
                             Margin 只管"与 H 贴多近"（第一个数）——它的上下分量已经不起作用了。 -->
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="HeadingChoiceHostShift" />
                        </Border.RenderTransform>
                        <!-- Spacing＝三个选项彼此的距离（0＝紧贴）。改了不用动代码：
                             展开宽度与角标落点都是按"格子宽 + Spacing"自己算的。
                             **格子本身就是那个框**：悬停／选中的底色和边框都走模板，所以
                             框的大小＝格子的 Width/Height、框的圆角＝CornerRadius——各只有一个数要调。
                             选中的底色/边框取的是主题里那两档（#20FFFFFF 底 + #68FFFFFF 边）。

                             数字走 LumiDigitStyle（Theme/LumiTokens.xaml）：字号 + **压过的行高**，
                             让墨迹在框里正中（文字默认按行框居中，数字会偏低约 0.85dip）。
                             角标照**数字**量落点，跟着一起走，不用另调。 -->
                        <StackPanel x:Name="HeadingChoiceStrip" Orientation="Horizontal" Spacing="0">
                            <ToggleButton x:Name="HeadingChoice1" Style="{StaticResource LumiChoiceStyle}"
                                          Tag="1"
                                          Click="OnHeadingChoiceClick"
                                          ToolTipService.ToolTip="常用标题设为 1">
                                <!-- 数字**必须套一层容器**：不能让它是按钮 ContentPresenter 的直接内容——
                                     那会把样式的 LineHeight 顶掉（ContentPresenter 把自己的一套文字属性按局部值
                                     强加给内容），行高压不下去，数字就在框里偏低约 0.85dip。 -->
                                <Grid>
                                    <TextBlock x:Name="HeadingChoiceText1" Text="1"
                                               Style="{StaticResource LumiDigitStyle}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </ToggleButton>
                            <ToggleButton x:Name="HeadingChoice2" Style="{StaticResource LumiChoiceStyle}"
                                          Tag="2"
                                          Click="OnHeadingChoiceClick"
                                          ToolTipService.ToolTip="常用标题设为 2">
                                <Grid>
                                    <TextBlock x:Name="HeadingChoiceText2" Text="2"
                                               Style="{StaticResource LumiDigitStyle}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </ToggleButton>
                            <ToggleButton x:Name="HeadingChoice3" Style="{StaticResource LumiChoiceStyle}"
                                          Tag="3"
                                          Click="OnHeadingChoiceClick"
                                          ToolTipService.ToolTip="常用标题设为 3">
                                <Grid>
                                    <TextBlock x:Name="HeadingChoiceText3" Text="3"
                                               Style="{StaticResource LumiDigitStyle}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </ToggleButton>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="4"
                            VerticalAlignment="Center">
                    <!-- 右下角保存状态：转圈（保存中）/ 对勾（已保存）/ 警示（失败或临时提示）。
                         有临时提示时以提示文案为准（提示多半是失败信息，不能只藏在 Tooltip 里）。
                         图标与显隐由 code-behind 的 UpdateStatusVisuals 统一管，完整文案进 Tooltip。 -->
                    <ProgressRing x:Name="StatusProgress"
                                  Width="14" Height="14"
                                  IsActive="False"
                                  Visibility="Collapsed" />
                    <FontIcon x:Name="StatusIcon"
                              Style="{StaticResource LumiChromeIconStyle}"
                              Glyph="&#xE305;"
                              Foreground="#FF75697C" />
                    <TextBlock x:Name="StatusCountText"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="#FF75697C" />
                    <TextBlock x:Name="StatusHintText"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="#FF75697C"
                               Visibility="Collapsed" />
                </StackPanel>

                <!-- 看得见的那一个角标数字：收起时它停在 H 的右下角（正好盖住面里那个占位），
                     展开时**滑到当前选中的选项上**——选项自己的数字那一刻让位，看起来就是角标飞了过去。
                     它是工具栏之上的一层（排在最后＝z 序最高，且不吃指针），
                     位置用 TranslateTransform 驱动（Canvas.Left/Top 不能做动画）。
                     外框是**固定 14×30（＝选项格子一样大）**、数字在框里居中：这样"摆到某格上"
                     就是把两个等大的框对齐，不用去问文字的实测宽度（那个数会随数字/字体变，
                     首帧还可能读到 0——摆偏一点点，看起来就是"飞过头"）。 -->
                <Canvas x:Name="HeadingBadgeLayer" Grid.ColumnSpan="2" IsHitTestVisible="False">
                    <Border x:Name="HeadingBadge"
                            Width="14" Height="30"
                            Opacity="0"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="HeadingBadgeScale" />
                                <TranslateTransform x:Name="HeadingBadgeShift" />
                            </TransformGroup>
                        </Border.RenderTransform>
                        <TextBlock x:Name="HeadingBadgeText"
                                   Style="{StaticResource LumiDigitStyle}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                </Canvas>
            </Grid>
        </Border>

        <!-- 文字底色取色器（展开式色带）：铺满窗口的覆盖层，空白处不吃指针（见控件里的纪律说明）；
             放在最后＝z 序最高，色带压在编辑区之上。 -->
        <controls:HighlightPicker x:Name="HighlightPickerLayer" Grid.RowSpan="3" />

    </Grid>
</Window>
