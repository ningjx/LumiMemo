<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="LumiMemo.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:LumiMemo.WinUI.Controls"
    Title="LumiMemo">

    <Grid x:Name="Root" Background="Transparent">
    <Grid.Resources>
        <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#14FFFFFF" />
        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#24FFFFFF" />
        <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#58FFFFFF" />
        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#78FFFFFF" />
        <SolidColorBrush x:Key="ToggleButtonBackground" Color="Transparent" />
        <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#14FFFFFF" />
        <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#24FFFFFF" />
        <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#20FFFFFF" />
        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#2AFFFFFF" />
        <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="Transparent" />
        <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="#58FFFFFF" />
        <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="#78FFFFFF" />
        <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="#68FFFFFF" />

        <!--
            编辑器滚动条：默认 Fluent 模板的白槽与上下箭头来自这些画刷资源，全部盖成透明后
            只剩细圆角滑块；「悬停平滑加宽（167ms）」是默认模板自带的状态动画，保留不动。
            作用域就这一扇窗口——管理器与对话框的滚动条不受影响。
        -->
        <SolidColorBrush x:Key="ScrollBarTrackFill" Color="Transparent" />
        <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="ScrollBarTrackStroke" Color="Transparent" />
        <SolidColorBrush x:Key="ScrollBarTrackStrokePointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="ScrollBarButtonBackground" Color="Transparent" />
        <SolidColorBrush x:Key="ScrollBarButtonBackgroundPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="ScrollBarButtonBackgroundPressed" Color="Transparent" />
        <SolidColorBrush x:Key="ScrollBarButtonArrowForeground" Color="Transparent" />
        <SolidColorBrush x:Key="ScrollBarButtonArrowForegroundPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="ScrollBarButtonArrowForegroundPressed" Color="Transparent" />

        <Style x:Key="GlassButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style x:Key="GlassToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="44" />
        </Grid.RowDefinitions>

        <Border x:Name="TitleBarHost"
                Grid.Row="0"
                Background="#18FFFFFF">
            <Grid x:Name="TitleBarGrid" Padding="14,0,7,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--
                    标题区：标题（可省略号裁剪）→ 进度圈 → 刷新按钮。
                    水平 StackPanel 以无限宽测量子项，标题的 MaxWidth 因此是唯一边界：
                    短标题时刷新按钮紧贴标题右侧；长标题时标题在 MaxWidth 处裁剪，
                    按钮被顶到最右，右缘距图标组 3——与图标组内部 Spacing 同距。
                -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="TitleText"
                               Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="#FF403747"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="{x:Bind controls:TitleLayout.TitleMaxWidth(TitleBarGrid.ActualWidth, ToolsPanel.ActualWidth), Mode=OneWay}" />
                    <ProgressRing x:Name="TitleProgress"
                                  Width="16" Height="16" Margin="6,0,0,0"
                                  VerticalAlignment="Center"
                                  IsActive="{x:Bind ViewModel.IsTitleGenerating, Mode=OneWay}"
                                  Visibility="{x:Bind ToVisibility(ViewModel.IsTitleGenerating), Mode=OneWay}" />
                    <Button x:Name="RefreshTitleButton"
                            Width="26" Height="26" Margin="6,0,3,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource GlassButtonStyle}"
                            IsEnabled="{x:Bind ViewModel.CanRegenerateTitle, Mode=OneWay}"
                            Click="OnRefreshTitleClick"
                            ToolTipService.ToolTip="重新生成标题">
                        <FontIcon Glyph="&#xE72C;" FontSize="12" />
                    </Button>
                </StackPanel>

                <StackPanel x:Name="ToolsPanel" Grid.Column="1" Orientation="Horizontal" Spacing="3">
                    <Button Width="32" Height="30"
                            Style="{StaticResource GlassButtonStyle}"
                            VerticalAlignment="Center"
                            Click="OnNewNoteClick"
                            ToolTipService.ToolTip="新建便笺">
                        <FontIcon Glyph="&#xE710;" FontSize="13" />
                    </Button>
                    <ToggleButton x:Name="PinButton"
                                  Style="{StaticResource GlassToggleButtonStyle}"
                                  Width="32" Height="30"
                                  VerticalAlignment="Center"
                                  IsChecked="{x:Bind ViewModel.IsTopMost, Mode=TwoWay}"
                                  ToolTipService.ToolTip="置顶">
                        <FontIcon Glyph="&#xE718;" FontSize="13" />
                    </ToggleButton>
                    <Button Width="32" Height="30"
                            Style="{StaticResource GlassButtonStyle}"
                            VerticalAlignment="Center"
                            Click="OnDeleteNoteClick"
                            ToolTipService.ToolTip="删除便签">
                        <FontIcon Glyph="&#xE74D;" FontSize="13" />
                    </Button>
                    <Button Width="32" Height="30"
                            Style="{StaticResource GlassButtonStyle}"
                            VerticalAlignment="Center"
                            Click="OnCloseClick"
                            ToolTipService.ToolTip="关闭">
                        <FontIcon Glyph="&#xE8BB;" FontSize="13" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="EditorHost" Grid.Row="1" />

        <Border Grid.Row="2"
                Background="#18FFFFFF"
                Padding="8,0,10,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                    <Button Style="{StaticResource GlassButtonStyle}" Width="30" Height="30" Click="OnBoldClick" ToolTipService.ToolTip="粗体">
                        <TextBlock Text="B" FontSize="16" FontWeight="Bold" />
                    </Button>
                    <Button Style="{StaticResource GlassButtonStyle}" Width="30" Height="30" Click="OnItalicClick" ToolTipService.ToolTip="斜体">
                        <TextBlock Text="I" FontSize="16" FontStyle="Italic" />
                    </Button>
                    <Button Style="{StaticResource GlassButtonStyle}" Width="30" Height="30" Click="OnUnderlineClick" ToolTipService.ToolTip="下划线">
                        <TextBlock Text="U" FontSize="15" TextDecorations="Underline" />
                    </Button>
                    <Button Style="{StaticResource GlassButtonStyle}" Width="30" Height="30" Click="OnStrikeClick" ToolTipService.ToolTip="删除线">
                        <TextBlock Text="S" FontSize="15" TextDecorations="Strikethrough" />
                    </Button>
                    <Rectangle Width="1" Height="18" Margin="3,0" Fill="#5075697C" />
                    <Button Style="{StaticResource GlassButtonStyle}" Width="34" Height="30" Click="OnInsertImageClick" ToolTipService.ToolTip="插入图片" Content="▧" />
                </StackPanel>
                <TextBlock x:Name="StatusText"
                           Grid.Column="1"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="#FF75697C"
                           Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
            </Grid>
        </Border>

    </Grid>
</Window>
