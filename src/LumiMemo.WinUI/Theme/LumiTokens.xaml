<?xml version="1.0" encoding="utf-8" ?>
<!--
    工具栏与图标的 token 层（设计稿 §2.1 的落地，第一刀见 §2.3）。

    这里只放**具名**东西：尺寸、墨色、图标字体、按钮/图标的具名样式。
    **不碰 `ButtonBackground` 这类主题键**——那是窗口级的覆盖（便签窗口在 MainWindow 的
    Grid.Resources 里自己声明），搬到 App 级会把管理器与对话框的常规按钮一起改掉。

    主题：现在**不分主题**（深色模式已推迟，见 D5）。深色那一轮再拆进 ThemeDictionaries，
    届时要改成 `{ThemeResource}` 引用（`{StaticResource}` 取不到主题字典里的键）。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Fluent UI System Icons (MIT) for chrome and manager windows. -->
    <FontFamily x:Key="LumiIconFont">ms-appx:///Assets/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular</FontFamily>
    <x:Double x:Key="LumiIconSizeChrome">16</x:Double>

    <!-- ── 尺寸与墨色 ── -->
    <x:Double x:Key="LumiToolbarControlSize">30</x:Double>
    <x:Double x:Key="LumiToolbarSwatchSize">16</x:Double>
    <SolidColorBrush x:Key="LumiIconInk" Color="#FF000000" />

    <!-- ── 玻璃上的按钮：透明底无边框，悬停/激活的底色由默认模板给 ── -->
    <Style x:Key="GlassButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style x:Key="GlassToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- ── 工具栏：30×30 的玻璃按钮，墨色＝图标黑 ──
         墨色设在**按钮**上（不是图标上）：悬停/按下时模板会把 ContentPresenter 的前景色换成
         主题里那一档，图标跟着变；要是把 Foreground 钉在 FontIcon 自己身上，那点悬停反馈就没了。 -->
    <Style x:Key="LumiToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource GlassButtonStyle}">
        <Setter Property="Width" Value="{StaticResource LumiToolbarControlSize}" />
        <Setter Property="Height" Value="{StaticResource LumiToolbarControlSize}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{StaticResource LumiIconInk}" />
    </Style>
    <Style x:Key="LumiToolbarToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource GlassToggleButtonStyle}">
        <Setter Property="Width" Value="{StaticResource LumiToolbarControlSize}" />
        <Setter Property="Height" Value="{StaticResource LumiToolbarControlSize}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{StaticResource LumiIconInk}" />
    </Style>

    <Style x:Key="LumiToolbarGlyphBoxStyle" TargetType="Canvas">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
    </Style>

    <Style x:Key="LumiToolbarStrokeStyle" TargetType="Path">
        <Setter Property="Stretch" Value="None" />
        <Setter Property="Stroke" Value="{StaticResource LumiIconInk}" />
        <Setter Property="StrokeThickness" Value="1.6" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
    </Style>

    <Style x:Key="LumiToolbarSwatchStyle" TargetType="Border">
        <Setter Property="Width" Value="{StaticResource LumiToolbarSwatchSize}" />
        <Setter Property="Height" Value="{StaticResource LumiToolbarSwatchSize}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="BorderBrush" Value="{StaticResource LumiIconInk}" />
        <Setter Property="BorderThickness" Value="1.6" />
    </Style>

    <!-- Shared artwork size for the heading button and drag choices. -->
    <Style x:Key="LumiHeadingFaceStyle" TargetType="Grid">
        <Setter Property="Width" Value="{StaticResource LumiToolbarSwatchSize}" />
        <Setter Property="Height" Value="{StaticResource LumiToolbarSwatchSize}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- The adjusted line height centers Segoe UI digits by their ink bounds. -->
    <Style x:Key="LumiDigitStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="LineHeight" Value="14.62" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{StaticResource LumiIconInk}" />
    </Style>

    <!-- ── 标题栏/管理器那档 16px 图标 ──
         同样偏下，但偏得少（行框占按钮的比例小），那一排没有实心块当参照，先不动。 -->
    <Style x:Key="LumiChromeIconStyle" TargetType="FontIcon">
        <Setter Property="FontFamily" Value="{StaticResource LumiIconFont}" />
        <Setter Property="FontSize" Value="{StaticResource LumiIconSizeChrome}" />
    </Style>

    <!-- ── 标题栏的四个按钮（32×30，比工具栏略宽）── -->
    <Style x:Key="LumiChromeButtonStyle" TargetType="Button" BasedOn="{StaticResource GlassButtonStyle}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Foreground" Value="{StaticResource LumiIconInk}" />
    </Style>
    <Style x:Key="LumiChromeToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource GlassToggleButtonStyle}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Foreground" Value="{StaticResource LumiIconInk}" />
    </Style>
</ResourceDictionary>
