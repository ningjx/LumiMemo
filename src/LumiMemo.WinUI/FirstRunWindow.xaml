<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="LumiMemo.WinUI.FirstRunWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="LumiMemo — 选择便笺存放位置">

    <Grid x:Name="Root" Padding="24,20,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="10">
            <TextBlock Text="选择便笺的存放位置"
                       FontSize="20"
                       FontWeight="SemiBold" />
            <TextBlock TextWrapping="Wrap"
                       FontSize="13"
                       Foreground="#FF75697C"
                       Text="便笺以 .lumi 文件保存在这个文件夹里。以后可以在「设置 → 存储位置」中更改。" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,20,0,0" Spacing="8" VerticalAlignment="Top">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="PathBox" />
                <Button Grid.Column="1" Content="浏览…" Click="OnBrowseClick" />
            </Grid>
            <TextBlock x:Name="ErrorText"
                       FontSize="12"
                       Foreground="#FFB42D3C"
                       TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Margin="0,16,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="12">
            <Button x:Name="QuitButton" Content="退出" Click="OnQuitClick" />
            <Button x:Name="ConfirmButton"
                    Content="确定"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="OnConfirmClick" />
        </StackPanel>
    </Grid>
</Window>
