<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="LumiMemo.WinUI.Pages.NoteListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:LumiMemo.WinUI.Controls">

    <UserControl.Resources>
        <controls:NoteColorBrushConverter x:Key="StripBrushConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="14,12,14,6" Spacing="8">
            <TextBox x:Name="SearchBox"
                     PlaceholderText="搜索便签（空格分隔多个关键词）"
                     TextChanged="OnSearchTextChanged" />

            <!--
                筛选/排序：点图标在**组内**横向展开子操作、把右侧的组向右推挤；
                圆角框把每个组圈成一个整体（图标 + 它的子操作，逻辑上不同级）。
                子操作有多项取值时（颜色），取值行在下一行展示。
            -->
            <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Border CornerRadius="10" BorderThickness="1" BorderBrush="#30FFFFFF" Padding="2">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="FilterIconButton"
                                    Style="{StaticResource IconButtonStyle}"
                                    Click="OnFilterIconClick"
                                    ToolTipService.ToolTip="筛选">
                                <FontIcon Glyph="&#xE71C;" FontSize="14" />
                            </Button>
                            <Button x:Name="ColorFilterChip"
                                    Margin="2,0,0,0"
                                    Visibility="Collapsed"
                                    Style="{StaticResource IconButtonStyle}"
                                    Click="OnColorChipClick"
                                    ToolTipService.ToolTip="颜色">
                                <FontIcon Glyph="&#xE790;" FontSize="14" />
                            </Button>
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="10" BorderThickness="1" BorderBrush="#30FFFFFF" Padding="2">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="SortIconButton"
                                    Style="{StaticResource IconButtonStyle}"
                                    Click="OnSortIconClick"
                                    ToolTipService.ToolTip="排序">
                                <FontIcon Glyph="&#xE8CB;" FontSize="14" />
                            </Button>
                            <Button x:Name="ModifiedTimeSortChip"
                                    Margin="2,0,0,0"
                                    Visibility="Collapsed"
                                    Style="{StaticResource IconButtonStyle}"
                                    Click="OnModifiedTimeSortClick"
                                    ToolTipService.ToolTip="按修改时间（新的在前）">
                                <FontIcon Glyph="&#xE823;" FontSize="14" />
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 颜色取值行：互斥单选，点击立即生效；「全部」= 不筛颜色。选中态由代码加深描边。 -->
                <StackPanel x:Name="ColorFilterValues"
                            Orientation="Horizontal" Spacing="6"
                            Visibility="Collapsed">
                    <Button x:Name="ColorFilterAll" Content="全部" FontSize="12"
                            MinWidth="0" Padding="9,1" CornerRadius="11"
                            BorderThickness="3" BorderBrush="#FF403747"
                            Click="OnColorFilterClick" />
                    <Button x:Name="ColorFilterYellow" Tag="Yellow" Width="22" Height="22" Padding="0"
                            CornerRadius="11" BorderThickness="1" BorderBrush="#40FFFFFF"
                            Background="#FFB58900" Click="OnColorFilterClick"
                            ToolTipService.ToolTip="黄色" />
                    <Button x:Name="ColorFilterPink" Tag="Pink" Width="22" Height="22" Padding="0"
                            CornerRadius="11" BorderThickness="1" BorderBrush="#40FFFFFF"
                            Background="#FFB0356B" Click="OnColorFilterClick"
                            ToolTipService.ToolTip="粉色" />
                    <Button x:Name="ColorFilterBlue" Tag="Blue" Width="22" Height="22" Padding="0"
                            CornerRadius="11" BorderThickness="1" BorderBrush="#40FFFFFF"
                            Background="#FF1F5FA8" Click="OnColorFilterClick"
                            ToolTipService.ToolTip="蓝色" />
                    <Button x:Name="ColorFilterGreen" Tag="Green" Width="22" Height="22" Padding="0"
                            CornerRadius="11" BorderThickness="1" BorderBrush="#40FFFFFF"
                            Background="#FF2E7D46" Click="OnColorFilterClick"
                            ToolTipService.ToolTip="绿色" />
                    <Button x:Name="ColorFilterPurple" Tag="Purple" Width="22" Height="22" Padding="0"
                            CornerRadius="11" BorderThickness="1" BorderBrush="#40FFFFFF"
                            Background="#FF6A3FA0" Click="OnColorFilterClick"
                            ToolTipService.ToolTip="紫色" />
                    <Button x:Name="ColorFilterOrange" Tag="Orange" Width="22" Height="22" Padding="0"
                            CornerRadius="11" BorderThickness="1" BorderBrush="#40FFFFFF"
                            Background="#FFB75E12" Click="OnColorFilterClick"
                            ToolTipService.ToolTip="橙色" />
                    <Button x:Name="ColorFilterGray" Tag="Gray" Width="22" Height="22" Padding="0"
                            CornerRadius="11" BorderThickness="1" BorderBrush="#40FFFFFF"
                            Background="#FF5F5F5F" Click="OnColorFilterClick"
                            ToolTipService.ToolTip="灰色" />
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <ListView x:Name="NotesList"
                  Grid.Row="1"
                  Margin="14,0,14,10"
                  ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                  IsItemClickEnabled="True"
                  ItemClick="OnNoteItemClick"
                  SelectionMode="None">
            <!-- 容器自身不加内边距：色条要贴住条目左缘，跟上方搜索框对齐。 -->
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <!-- 根 Grid 必须有背景，否则空白区域的悬停事件收不到。 -->
                    <Grid x:Name="ItemRoot"
                          Background="Transparent"
                          Padding="0,8,10,8"
                          MinHeight="62"
                          PointerEntered="OnItemPointerEntered"
                          PointerExited="OnItemPointerExited">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 色条即"修改颜色"按钮：贴住条目左缘，点开色板。
                             内容对齐要 Stretch（否则 ContentPresenter 会把色条量成 0 高）；
                             悬停不留系统的白底，反馈交给整行高亮和按下态。 -->
                        <Button Grid.Column="0"
                                Width="14" Padding="0"
                                VerticalAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Background="Transparent" BorderThickness="0" CornerRadius="0"
                                Click="OnItemColorClick"
                                ToolTipService.ToolTip="修改颜色">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#10FFFFFF" />
                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                            </Button.Resources>
                            <Border Width="4"
                                    CornerRadius="2"
                                    HorizontalAlignment="Left"
                                    Margin="0,2,0,2"
                                    Background="{Binding Note.Color, Converter={StaticResource StripBrushConverter}}" />
                        </Button>

                        <Grid Grid.Column="1" Margin="8,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <controls:SnippetTextBlock Snippet="{Binding TitleSnippet}"
                                                           NoteColor="{Binding Note.Color}"
                                                           IsTitle="True" />
                                <ProgressRing Grid.Column="1" Width="16" Height="16"
                                              Margin="8,0,0,0" IsActive="{Binding IsGenerating}"
                                              Visibility="{Binding ProgressVisibility}" />
                            </Grid>
                            <!-- 两行封顶、尾部省略与配色由控件自己固定（见 SnippetTextBlock）。 -->
                            <controls:SnippetTextBlock Grid.Row="1"
                                                       Margin="0,4,0,0"
                                                       Snippet="{Binding Snippet}"
                                                       NoteColor="{Binding Note.Color}" />
                        </Grid>

                        <!--
                            悬停时右上角浮出的操作按钮（淡入淡出由代码控制）。
                            图标是自绘的实心版（白色填充 + 深色描边）：填充本身就能盖住
                            底下的标题文字，不依赖按钮底色。
                        -->
                        <Border x:Name="ItemActions"
                                Grid.Column="1"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Padding="4,2"
                                Opacity="0" IsHitTestVisible="False">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button Width="28" Height="24"
                                    Style="{StaticResource IconButtonStyle}"
                                    Click="OnItemDuplicateClick"
                                    ToolTipService.ToolTip="复制">
                                <Canvas Width="16" Height="16">
                                    <Rectangle Canvas.Left="1" Canvas.Top="1" Width="9.5" Height="9.5"
                                               RadiusX="2" RadiusY="2"
                                               Fill="White" Stroke="#FF403747" StrokeThickness="1.2" />
                                    <Rectangle Canvas.Left="5.5" Canvas.Top="5.5" Width="9.5" Height="9.5"
                                               RadiusX="2" RadiusY="2"
                                               Fill="White" Stroke="#FF403747" StrokeThickness="1.2" />
                                </Canvas>
                            </Button>
                            <Button Width="28" Height="24"
                                    Style="{StaticResource IconButtonStyle}"
                                    Click="OnItemDeleteClick"
                                    ToolTipService.ToolTip="删除">
                                <Canvas Width="16" Height="16">
                                    <Rectangle Canvas.Left="5.8" Canvas.Top="1.2" Width="4.4" Height="2.2"
                                               RadiusX="1" RadiusY="1"
                                               Fill="White" Stroke="#FF403747" StrokeThickness="1.1" />
                                    <Rectangle Canvas.Left="2.6" Canvas.Top="3.4" Width="10.8" Height="2.6"
                                               RadiusX="1.1" RadiusY="1.1"
                                               Fill="White" Stroke="#FF403747" StrokeThickness="1.1" />
                                    <Path Fill="White" Stroke="#FF403747" StrokeThickness="1.1"
                                          Data="M4.4,6.6 L11.6,6.6 L10.7,14.6 A1.3,1.3 0 0 1 9.4,15.7 L6.6,15.7 A1.3,1.3 0 0 1 5.3,14.6 Z" />
                                </Canvas>
                            </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
