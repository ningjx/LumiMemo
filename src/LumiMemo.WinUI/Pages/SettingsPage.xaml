<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="LumiMemo.WinUI.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="20,16,20,16">
        <StackPanel Spacing="14" MaxWidth="560" HorizontalAlignment="Left">
            <ToggleSwitch x:Name="EnabledSwitch" Header="自动生成标题" />
            <TextBox x:Name="EndpointBox"
                     Header="端点"
                     PlaceholderText="https://api.openai.com/v1/chat/completions" />
            <TextBox x:Name="ModelBox"
                     Header="模型"
                     PlaceholderText="填写服务商提供的模型 ID" />
            <PasswordBox x:Name="KeyBox" Header="API 密钥" />
            <CheckBox x:Name="ClearKeyCheck" Content="清除已保存的密钥" />
            <TextBlock Text="密钥以明文保存在本机 settings.json。"
                       FontSize="12"
                       Foreground="#FF75697C"
                       TextWrapping="Wrap" />
            <TextBox x:Name="PromptBox"
                     Header="生成标题的提示词"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     Height="104" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="SaveButton"
                        Content="保存"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="OnSaveClick" />
                <TextBlock x:Name="StatusText"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="#FF2E7D46" />
            </StackPanel>
            <TextBlock x:Name="ErrorText"
                       FontSize="12"
                       Foreground="#FFB42D3C"
                       TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
