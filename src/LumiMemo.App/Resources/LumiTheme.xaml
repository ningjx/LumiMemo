<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <!-- 当前外观的语义资源。以后换肤替换整份字典，并保持这些键名与资源类型不变。 -->
  <!-- 窗口级实色用于系统材质不可用时；内部面板保留透出 DWM 背景的透明度。 -->
  <sys:Boolean x:Key="LumiUseSystemBackdrop">True</sys:Boolean>
  <SolidColorBrush x:Key="LumiWindowSurfaceBrush" Color="#FFF1EFF4" />
  <SolidColorBrush x:Key="LumiTextBrush" Color="#FF292735" />
  <SolidColorBrush x:Key="LumiContentPanelBrush" Color="#B8FDFBFF" />
  <SolidColorBrush x:Key="LumiControlSurfaceBrush" Color="#E8FFFFFF" />
  <SolidColorBrush x:Key="LumiSectionSurfaceBrush" Color="#BFEDEAF5" />
  <SolidColorBrush x:Key="LumiToolbarSurfaceBrush" Color="#B8F9F6FF" />
  <SolidColorBrush x:Key="LumiRaisedSurfaceBrush" Color="#CFFFFFFF" />
  <SolidColorBrush x:Key="LumiHoverSurfaceBrush" Color="#D8FFFFFF" />
  <SolidColorBrush x:Key="LumiPressedSurfaceBrush" Color="#D5E6DDF2" />
  <SolidColorBrush x:Key="LumiSelectedSurfaceBrush" Color="#DDEBE3F8" />
  <SolidColorBrush x:Key="LumiBorderBrush" Color="#FFB9B2CA" />
  <SolidColorBrush x:Key="LumiSubtleBorderBrush" Color="#FFCEC8DA" />
  <SolidColorBrush x:Key="LumiAccentBrush" Color="#FF7157A6" />
  <SolidColorBrush x:Key="LumiOnAccentBrush" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="LumiMutedTextBrush" Color="#FF645F72" />
  <SolidColorBrush x:Key="LumiFilterTextBrush" Color="#FF5D5770" />
  <SolidColorBrush x:Key="LumiSecondaryTextBrush" Color="#FF605B6D" />
  <SolidColorBrush x:Key="LumiTertiaryTextBrush" Color="#FF777184" />
  <SolidColorBrush x:Key="LumiPlaceholderTextBrush" Color="#FF807A8C" />
  <SolidColorBrush x:Key="LumiErrorTextBrush" Color="#FFB4314C" />

  <SolidColorBrush x:Key="LumiNoteSurfaceBrush" Color="#FFF7F2E7" />
  <SolidColorBrush x:Key="LumiNoteEditorBrush" Color="#A8FFFDFB" />
  <SolidColorBrush x:Key="LumiNoteTextBrush" Color="#FF302B39" />
  <SolidColorBrush x:Key="LumiNoteChromeBrush" Color="#B8EDE5F5" />
  <SolidColorBrush x:Key="LumiGlassEdgeBrush" Color="#C9FFFFFF" />
  <SolidColorBrush x:Key="LumiNoteActionBrush" Color="#FF695A72" />
  <SolidColorBrush x:Key="LumiNoteActionHoverBrush" Color="#FF443954" />
  <SolidColorBrush x:Key="LumiNoteActionSelectedBrush" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="LumiNoteActionHoverSurfaceBrush" Color="#BCFFFFFF" />
  <SolidColorBrush x:Key="LumiNoteActionPressedSurfaceBrush" Color="#E6E9DEF3" />
  <FontFamily x:Key="LumiFontFamily">Microsoft YaHei UI</FontFamily>

  <Style x:Key="LumiDialogButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource LumiControlSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LumiBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Chrome"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="10">
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource LumiHoverSurfaceBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource LumiPressedSurfaceBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource LumiAccentBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
