<Window x:Class="LumiMemo.App.Views.ChoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LumiMemo"
        SizeToContent="Height"
        Width="420"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="#FFFDFBF3"
        FontFamily="Microsoft YaHei UI"
        FontSize="14">

  <!--
    自绘的三选一对话框。MessageBox 做不到：它的按钮是系统定的「是 / 否 / 取消」，
    既改不了文案也放不下第三档，而 §7.3 要的恰恰是「重命名 / 恢复到笔记目录根 / 取消」。
    按钮上的文字必须能被用户一眼分辨——恢复冲突那一次点错就是覆盖掉另一个文件。
  -->
  <StackPanel Margin="20,18,20,16">
    <TextBlock x:Name="MessageText"
               TextWrapping="Wrap"
               Margin="0,0,0,16" />

    <!-- 选项由代码后置按传入的 choices 逐条造出来：条数不定，写不进 XAML -->
    <StackPanel x:Name="ChoicePanel" Margin="4,0,0,4" />

    <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,20,0,0">
      <Button x:Name="CancelButton"
              Content="取消"
              IsCancel="True"
              MinWidth="88"
              Padding="14,6"
              Margin="0,0,8,0"
              Click="OnCancelClick" />
      <Button x:Name="AcceptButton"
              Content="确定"
              IsDefault="True"
              MinWidth="88"
              Padding="14,6"
              Click="OnAcceptClick" />
    </StackPanel>
  </StackPanel>
</Window>
