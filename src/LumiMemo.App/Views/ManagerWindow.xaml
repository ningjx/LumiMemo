<Window x:Class="LumiMemo.App.Views.ManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LumiMemo.App.Views"
        Title="LumiMemo"
        Width="720"
        Height="520"
        MinWidth="480"
        MinHeight="360"
        WindowStartupLocation="CenterScreen"
        Background="#FFFDFBF3"
        FontFamily="Microsoft YaHei UI"
        FontSize="14">

  <!--
    管理器用**标准窗口 chrome**（§15.8 的裁决）：它是个普通的列表窗口，
    没有无边框的必要，也就用不上 WindowChrome / Win32 那一整套。
    便签窗口走的是完全不同的一条路（自绘标题条 + Aero Snap 热区），
    两者的窗口层代码刻意不共享——共同点只有「都是 Window」这一句废话。
  -->
  <Window.Resources>
    <Style x:Key="ToolButton" TargetType="Button">
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="#FFD9D2B8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4">
              <ContentPresenter Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#FFF7E9A0" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- 工具条 -->
    <Border Grid.Row="0" Background="#FFF7E9A0" Padding="12,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0"
                   Text="{Binding Title}"
                   VerticalAlignment="Center"
                   FontSize="16"
                   FontWeight="SemiBold" />

        <!--
          搜索框。UpdateSourceTrigger 必须显式写成 PropertyChanged：TextBox.Text 的默认触发是
          LostFocus，那样去抖定时器要等用户点到别处才起步，"输入停止 150ms 后搜索"就成了空话。
        -->
        <Grid Grid.Column="1" Margin="24,0,16,0" VerticalAlignment="Center">
          <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                   Padding="6,4"
                   Background="#FFFFFDF6"
                   BorderBrush="#FFD9D2B8"
                   BorderThickness="1" />

          <!-- 占位提示。WPF 的 TextBox 没有内置占位符，只能自己叠一层 -->
          <TextBlock Text="搜索便签…"
                     Margin="9,0,0,0"
                     VerticalAlignment="Center"
                     Foreground="#FF9A9484"
                     IsHitTestVisible="False">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding SearchQuery}" Value="">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>

        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <Button Style="{StaticResource ToolButton}"
                  Content="刷新"
                  Command="{Binding RefreshCommand}" />
          <Button Style="{StaticResource ToolButton}"
                  Content="显示全部"
                  Command="{Binding ShowAllCommand}" />
          <Button Style="{StaticResource ToolButton}"
                  Content="隐藏全部"
                  Command="{Binding HideAllCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- 便签列表 -->
    <ListBox x:Name="NoteList"
             Grid.Row="1"
             ItemsSource="{Binding Notes}"
             SelectedItem="{Binding SelectedNote, Mode=TwoWay}"
             MouseDoubleClick="OnListMouseDoubleClick"
             HorizontalContentAlignment="Stretch"
             BorderThickness="0"
             Background="Transparent"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid Margin="8,7">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Grid.Column="0"
                       Text="{Binding Title}"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />

            <!--
              副标题。搜索时这里是摘要、命中那一段换 Accent 色加粗，不搜索时是「修改时间 · 字数」。
              两种情况都从 SubtitleSegments 来，模板里不必判断现在是哪种。

              非命中部分的颜色用 Foreground 设成灰的，而不是像别处那样压 Opacity：
              压 Opacity 会连命中段的强调色一起压暗，高亮就白做了。
              SnippetPresenter 只给命中段设前景色，其余一段一律不设、继承这里。
            -->
            <views:SnippetPresenter Grid.Row="0"
                                    Grid.Column="1"
                                    Segments="{Binding SubtitleSegments}"
                                    FontSize="12"
                                    Foreground="#FF8A8578"
                                    MaxWidth="320"
                                    Margin="12,0,0,0"
                                    TextTrimming="CharacterEllipsis" />

            <TextBlock Grid.Row="1"
                       Grid.Column="0"
                       Grid.ColumnSpan="2"
                       Text="{Binding Preview}"
                       FontSize="12"
                       Opacity="0.6"
                       Margin="0,3,0,0"
                       TextTrimming="CharacterEllipsis" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- 空列表提示与计数。两者都在同一行，靠可见性切换 -->
    <TextBlock Grid.Row="1"
               Text="{Binding EmptyHint}"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Opacity="0.5"
               IsHitTestVisible="False">
      <TextBlock.Style>
        <Style TargetType="TextBlock">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding Notes.Count}" Value="0">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </TextBlock.Style>
    </TextBlock>

    <!-- 状态栏 -->
    <Border Grid.Row="2" Background="#FFF2EDDC" Padding="12,6">
      <Grid>
        <TextBlock Text="{Binding CountText}" FontSize="12" Opacity="0.7" />

        <!-- 命中超过单次渲染上限时的提示（§15.8）。没超过时 OverflowHint 是空串，不占宽度 -->
        <TextBlock Text="{Binding OverflowHint}"
                   HorizontalAlignment="Right"
                   FontSize="12"
                   Foreground="#FFB58900"
                   TextTrimming="CharacterEllipsis" />
      </Grid>
    </Border>
  </Grid>
</Window>
