<Window x:Class="LumiMemo.App.Views.ManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:LumiMemo.App.Views.Converters"
        xmlns:views="clr-namespace:LumiMemo.App.Views"
        Title="LumiMemo"
        Width="720"
        Height="520"
        MinWidth="480"
        MinHeight="360"
        WindowStartupLocation="CenterScreen"
        Background="#FFFDFBF3"
        FontFamily="Microsoft YaHei UI"
        FontSize="14">

  <!--
    管理器用**标准窗口 chrome**（§15.8 的裁决）：它是个普通的列表窗口，
    没有无边框的必要，也就用不上 WindowChrome / Win32 那一整套。
    便签窗口走的是完全不同的一条路（自绘标题条 + Aero Snap 热区），
    两者的窗口层代码刻意不共享——共同点只有「都是 Window」这一句废话。
  -->
  <Window.Resources>
    <conv:NoteColorToBrushConverter x:Key="NoteColorToBrush" />

    <Style x:Key="ToolButton" TargetType="Button">
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="#FFD9D2B8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4">
              <ContentPresenter Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#FFF7E9A0" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!--
      过滤条上的一个条件（§15.8）。做成拨动按钮而不是复选框：它是"当前正在按这个条件看"，
      点一下生效、再点一下取消，与复选框那种"勾选并提交"的心智不同。
      下面是勾中态的实心色，与上面三个工具按钮刻意拉开距离——过滤器改变的是"看到什么"，
      工具按钮执行的是"做什么"。
    -->
    <Style x:Key="FilterChip" TargetType="ToggleButton">
      <Setter Property="Padding" Value="10,2" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#FF6B6555" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Chip"
                    Background="#FFFFFDF6"
                    BorderBrush="#FFD9D2B8"
                    BorderThickness="1"
                    CornerRadius="10">
              <ContentPresenter Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chip" Property="Background" Value="#FFF7E9A0" />
              </Trigger>

              <!--
                勾中态放在悬停之后：两个条件同时成立时后写的赢，
                否则鼠标停在已勾中的那一颗上，它会退回悬停色，看着像被取消了。
              -->
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Chip" Property="Background" Value="#FFB58900" />
                <Setter TargetName="Chip" Property="BorderBrush" Value="#FFB58900" />
                <Setter Property="Foreground" Value="#FFFFFDF6" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!--
      「全部」那一档：它不是第四个条件，而是"把条件都清掉"，所以是 Button 不是 ToggleButton
      ——做成拨动按钮的话它就有了自己的 on/off 状态，而"全部"被点掉的画面是没有意义的。
      勾着任意一个条件时它自己亮起来（下面那个 DataTrigger），表示"现在不是全部"。
    -->
    <Style x:Key="FilterReset" TargetType="Button" BasedOn="{StaticResource ToolButton}">
      <Setter Property="Padding" Value="10,2" />
      <Setter Property="Margin" Value="0,0,12,0" />
      <Setter Property="FontSize" Value="12" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsFilterAll}" Value="True">
          <Setter Property="Background" Value="#FFF7E9A0" />
          <Setter Property="BorderBrush" Value="#FFB58900" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- 工具条 -->
    <Border Grid.Row="0" Background="#FFF7E9A0" Padding="12,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0"
                   Text="{Binding Title}"
                   VerticalAlignment="Center"
                   FontSize="16"
                   FontWeight="SemiBold" />

        <!--
          搜索框。UpdateSourceTrigger 必须显式写成 PropertyChanged：TextBox.Text 的默认触发是
          LostFocus，那样去抖定时器要等用户点到别处才起步，"输入停止 150ms 后搜索"就成了空话。
        -->
        <Grid Grid.Column="1" Margin="24,0,16,0" VerticalAlignment="Center">
          <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                   Padding="6,4"
                   Background="#FFFFFDF6"
                   BorderBrush="#FFD9D2B8"
                   BorderThickness="1" />

          <!-- 占位提示。WPF 的 TextBox 没有内置占位符，只能自己叠一层 -->
          <TextBlock Text="搜索便签…"
                     Margin="9,0,0,0"
                     VerticalAlignment="Center"
                     Foreground="#FF9A9484"
                     IsHitTestVisible="False">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding SearchQuery}" Value="">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>

        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <!--
            新建（§15.8 顶部那一格）。放在最前面：它是这个窗口里唯一"造出新东西"的动作，
            与后面四个"对已有的东西做事"不属一类。
          -->
          <Button Style="{StaticResource ToolButton}"
                  Content="+ 新建"
                  Command="{Binding NewNoteCommand}" />
          <Button Style="{StaticResource ToolButton}"
                  Content="刷新"
                  Command="{Binding RefreshCommand}" />
          <Button Style="{StaticResource ToolButton}"
                  Content="显示全部"
                  Command="{Binding ShowAllCommand}" />
          <Button Style="{StaticResource ToolButton}"
                  Content="隐藏全部"
                  Command="{Binding HideAllCommand}" />

          <!--
            设置入口。用齿轮而不是「设置」两个字，是因为它跟左边三个不属一类：
            那三个是「对便签做事」，它是「对程序做事」，字形不同比加一条竖线便宜。
            ToolTip 补上文字，免得有人认不出这个字。
          -->
          <Button Style="{StaticResource ToolButton}"
                  Content="⚙"
                  FontSize="16"
                  Padding="10,2"
                  Margin="8,0,0,0"
                  ToolTip="设置"
                  Click="OnSettingsClick" />
        </StackPanel>
      </Grid>
    </Border>

    <!--
      过滤条（§15.8）。三个条件是「与」关系：勾了"置顶"和"最近 7 天"就是两者同时满足。
      「全部」在语义上是"一个条件都不勾"，所以它不是第四个勾选框，见上面 FilterReset 的说明。
    -->
    <Border Grid.Row="1" Background="#FFF2EDDC" Padding="12,7">
      <StackPanel Orientation="Horizontal">
        <Button Style="{StaticResource FilterReset}"
                Content="全部"
                Command="{Binding ClearFiltersCommand}" />
        <ToggleButton Style="{StaticResource FilterChip}"
                      Content="置顶"
                      IsChecked="{Binding FilterTopMost}" />
        <ToggleButton Style="{StaticResource FilterChip}"
                      Content="有标签"
                      IsChecked="{Binding FilterTagged}" />
        <ToggleButton Style="{StaticResource FilterChip}"
                      Content="最近 7 天"
                      IsChecked="{Binding FilterRecent}" />
      </StackPanel>
    </Border>

    <!-- 便签列表 -->
    <ListBox x:Name="NoteList"
             Grid.Row="2"
             ItemsSource="{Binding Notes}"
             SelectedItem="{Binding SelectedNote, Mode=TwoWay}"
             MouseDoubleClick="OnListMouseDoubleClick"
             ContextMenuService.ContextMenuOpening="OnListContextMenuOpening"
             HorizontalContentAlignment="Stretch"
             BorderThickness="0"
             Background="Transparent"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             ScrollViewer.CanContentScroll="True"
             VirtualizingStackPanel.IsVirtualizing="True"
             VirtualizingStackPanel.VirtualizationMode="Recycling">

      <!--
        虚拟化（§15.8 规格里要求"必须确认 IsVirtualizing 没被关掉"）。
        上面三行是显式钉住的，不靠默认值：
          - IsVirtualizing / VirtualizationMode：默认就是 True / Recycling，写出来是为了
            将来有人给 ListBox 套一层外层的 ScrollViewer 时能立刻看出这里被改过。
          - CanContentScroll 必须是 True。它是虚拟化的实际开关——为 False 时 ListBox 会
            按像素滚动，于是必须先把所有项都测量一遍，虚拟化就名存实亡了。
            它与 HorizontalScrollBarVisibility="Disabled" 是一对：外层 ScrollViewer
            拿到无限宽度时同样会失去虚拟化，所以横向那一根要关掉。
        这个列表可能有上千条（搜索命中多时），关掉虚拟化的代价是肉眼可见的卡顿。
      -->
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid Margin="8,7">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Grid.Column="0"
                       Text="{Binding Title}"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />

            <!--
              标签徽章（§15.8 结果项规格）。紧挨着标题排，与正文里的标签一头一尾。
              空标签时这个 ItemsControl 什么都不画，也不占宽度。
            -->
            <ItemsControl Grid.Row="0"
                          Grid.Column="1"
                          ItemsSource="{Binding Tags}"
                          VerticalAlignment="Center"
                          Margin="8,0,0,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="#FFF0E8C8"
                          BorderBrush="#FFE0D6B4"
                          BorderThickness="1"
                          CornerRadius="3"
                          Padding="5,0"
                          Margin="0,0,4,0">
                    <TextBlock Text="{Binding}"
                               FontSize="11"
                               Foreground="#FF7A7460" />
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!--
              副标题。搜索时这里是摘要、命中那一段换 Accent 色加粗，不搜索时是「修改时间 · 字数」。
              两种情况都从 SubtitleSegments 来，模板里不必判断现在是哪种。

              非命中部分的颜色用 Foreground 设成灰的，而不是像别处那样压 Opacity：
              压 Opacity 会连命中段的强调色一起压暗，高亮就白做了。
              SnippetPresenter 只给命中段设前景色，其余一段一律不设、继承这里。
            -->
            <views:SnippetPresenter Grid.Row="0"
                                    Grid.Column="2"
                                    Segments="{Binding SubtitleSegments}"
                                    FontSize="12"
                                    Foreground="#FF8A8578"
                                    MaxWidth="320"
                                    Margin="12,0,0,0"
                                    TextTrimming="CharacterEllipsis" />

            <!--
              颜色点（§15.8 结果项规格）。取的是调色板里的强调色而不是背景色——
              这个点只有 8 像素见方，七个浅色背景在白底上彼此分不开。
              颜色名到笔刷的映射在 NoteColorToBrushConverter 里，调色板只有一处。
            -->
            <Ellipse Grid.Row="0"
                     Grid.Column="3"
                     Width="8"
                     Height="8"
                     Margin="10,0,2,0"
                     VerticalAlignment="Center"
                     Fill="{Binding Color, Converter={StaticResource NoteColorToBrush}}" />

            <TextBlock Grid.Row="1"
                       Grid.Column="0"
                       Grid.ColumnSpan="4"
                       Text="{Binding Preview}"
                       FontSize="12"
                       Opacity="0.6"
                       Margin="0,3,0,0"
                       TextTrimming="CharacterEllipsis" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>

      <!--
        右键菜单（§15.8 结果项规格里的那一行）。挂在整个 ListBox 上而不是每一行上：
        每行一个的话，虚拟化列表滚一遍就造出一堆一模一样的 ContextMenu 实例。
        DataContext 显式绑到 PlacementTarget —— ContextMenu 是独立的 Popup，
        不在 ListBox 的视觉树里，靠继承拿不到 ViewModel。

        试过改挂到 ItemContainerStyle 上（那样空白处的右键就不必再拦），行不通：
        ItemContainerStyle 里一个不带 BasedOn 的隐式 Style 会把 ListBoxItem 的
        默认样式整个替换掉，连 Template 一起——列表项当场就不正常了。
        要挂也行，得补 BasedOn="{StaticResource {x:Type ListBoxItem}}"，
        但那是为了绕开一个本来就不存在的问题：空白处的右键已经有
        ContextMenuOpening 在拦（见 ManagerWindow.xaml.cs）。

        规格那一行还列着「颜色」与「标签」两项，都还没实现：它们要连着
        §15.3 的调色板与便签窗口换肤一起做，否则用户选了蓝色、便签窗口还是黄的。
        先把点不动的死项放上来，比现在缺两项更糟。
      -->
      <ListBox.ContextMenu>
        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
          <MenuItem Header="{Binding TopMostMenuHeader}"
                    Command="{Binding ToggleTopMostCommand}"
                    CommandParameter="{Binding SelectedNote}" />
          <Separator />
          <MenuItem Header="在资源管理器中显示"
                    Command="{Binding RevealInExplorerCommand}"
                    CommandParameter="{Binding SelectedNote}" />
          <MenuItem Header="移入回收站"
                    Command="{Binding DeleteNoteCommand}"
                    CommandParameter="{Binding SelectedNote}" />
        </ContextMenu>
      </ListBox.ContextMenu>
    </ListBox>

    <!-- 空列表提示与计数。两者都在同一行，靠可见性切换 -->
    <TextBlock Grid.Row="2"
               Text="{Binding EmptyHint}"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Opacity="0.5"
               IsHitTestVisible="False">
      <TextBlock.Style>
        <Style TargetType="TextBlock">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding Notes.Count}" Value="0">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </TextBlock.Style>
    </TextBlock>

    <!-- 状态栏 -->
    <Border Grid.Row="3" Background="#FFF2EDDC" Padding="12,6">
      <Grid>
        <TextBlock Text="{Binding CountText}" FontSize="12" Opacity="0.7" />

        <!-- 命中超过单次渲染上限时的提示（§15.8）。没超过时 OverflowHint 是空串，不占宽度 -->
        <TextBlock Text="{Binding OverflowHint}"
                   HorizontalAlignment="Right"
                   FontSize="12"
                   Foreground="#FFB58900"
                   TextTrimming="CharacterEllipsis" />
      </Grid>
    </Border>
  </Grid>
</Window>
