<Window x:Class="LumiMemo.App.Views.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LumiMemo.App.Views"
        Title="LumiMemo"
        SizeToContent="Height"
        Width="440"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        views:WindowBackdrop.Enabled="{DynamicResource LumiUseSystemBackdrop}"
        Background="{DynamicResource LumiWindowSurfaceBrush}"
        Foreground="{DynamicResource LumiTextBrush}"
        FontFamily="{DynamicResource LumiFontFamily}"
        FontSize="14">

  <!--
    自绘的文本输入对话框（§15.8 的标签编辑用它）。文档没有给这个框的样子，是自拟的。
    为什么不直接用 MessageBox 或者一个可编辑的 InputBox：WPF 里根本没有 InputBox
    （那是 WinForms 的），而 MessageBox 连输入框都没有。

    校验不通过时**不关闭**，错误就写在输入框下面（见代码后置）。
  -->
  <Border Background="{DynamicResource LumiContentPanelBrush}" Padding="20,18,20,16">
    <StackPanel>
    <TextBlock x:Name="MessageText"
               TextWrapping="Wrap"
               Margin="0,0,0,12" />

    <!--
      单行。标签是用逗号连起来打的一串，多行只会让「回车提交」这件事变得含混
      （回车到底是换行还是确定）。
    -->
    <TextBox x:Name="InputBox"
             AcceptsReturn="False"
             Padding="6,4"
             Background="{DynamicResource LumiControlSurfaceBrush}"
             BorderBrush="{DynamicResource LumiBorderBrush}"
             BorderThickness="1">
      <TextBox.Template>
        <ControlTemplate TargetType="TextBox">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="10">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
          </Border>
        </ControlTemplate>
      </TextBox.Template>
    </TextBox>

    <!-- 校验失败时的提示。它是**红字而不是弹第二个框**：用户正要改的就是上面那一格 -->
    <TextBlock x:Name="ErrorText"
               Foreground="{DynamicResource LumiErrorTextBrush}"
               TextWrapping="Wrap"
               FontSize="12"
               Margin="0,6,0,0"
               Visibility="Collapsed" />

    <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,20,0,0">
      <Button x:Name="CancelButton"
              Style="{DynamicResource LumiDialogButtonStyle}"
              Content="取消"
              IsCancel="True"
              MinWidth="88"
              Padding="14,6"
              Margin="0,0,8,0"
              Click="OnCancelClick" />
      <!-- 这里的回车就是「确定」，理由见 DialogService 的类注释 -->
      <Button x:Name="AcceptButton"
              Style="{DynamicResource LumiDialogButtonStyle}"
              Content="确定"
              IsDefault="True"
              MinWidth="88"
              Padding="14,6"
              Click="OnAcceptClick" />
    </StackPanel>
    </StackPanel>
  </Border>
</Window>
