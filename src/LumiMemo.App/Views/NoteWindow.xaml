<Window x:Class="LumiMemo.App.Views.NoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LumiMemo.App.Views"
        Title="便签"
        Width="360"
        Height="420"
        MinWidth="300"
        MinHeight="120"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        AllowsTransparency="False"
        views:WindowBackdrop.Enabled="{DynamicResource LumiUseSystemBackdrop}"
        views:WindowBackdrop.FallbackBrushKey="LumiNoteSurfaceBrush"
        Background="{DynamicResource LumiNoteSurfaceBrush}"
        Foreground="{DynamicResource LumiNoteTextBrush}"
        FontFamily="{DynamicResource LumiFontFamily}"
        FontSize="14"
        Closing="OnClosing">

  <!--
    自绘标题栏 + WindowChrome（§15.2）。

    WindowStyle=None 之后窗口没有系统边框，但 WindowChrome 的两个属性把它补回来：
      · CaptionHeight=0    标题栏区域交给我们自己画，于是拖动要靠 DragMove()
      · ResizeBorderThickness=6  窗口边缘留出 6 DIP 的调整大小热区
    没有第二项的话，无边框窗口是**不能**从边缘拖拽改变大小的——
    位置记忆承诺了尺寸也要记住，用户却根本没法改尺寸，那就成了空话。

    WindowChrome.CornerRadius 保持 0；外轮廓由 DWM 按系统策略裁成圆角。

    AllowsTransparency 保持 False：毛玻璃由 DWM 绘制，不走 WPF 分层窗口。
    系统不支持 Acrylic 时，Window.Background 保持实色，内容仍可读。
  -->
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0"
                  ResizeBorderThickness="6"
                  CornerRadius="0"
                  GlassFrameThickness="0"
                  UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <!-- 标题栏上的小按钮：无边框，靠字色变化给反馈，免得静态时抢标题的视觉重量 -->
    <Style x:Key="TitleBarButton" TargetType="ButtonBase">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Margin" Value="4,0,0,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource LumiNoteActionBrush}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ButtonBase">
            <Border x:Name="Chrome"
                    Background="{TemplateBinding Background}"
                    CornerRadius="9">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                TextElement.Foreground="{TemplateBinding Foreground}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource LumiNoteActionHoverSurfaceBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource LumiNoteActionHoverBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource LumiNoteActionPressedSurfaceBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!--
      置顶按钮比上面多一条「按下」的视觉：它的 IsChecked 是个持久状态，
      而 ButtonBase 上没有这个属性，因此触发器只能写在派生类型的 Style 里。
      高亮走 Background 而不是上面的 Foreground——两者各用一种通道，
      鼠标悬停时就不会把选中色盖掉。
    -->
    <Style x:Key="TitleBarToggleButton"
           TargetType="ToggleButton"
           BasedOn="{StaticResource TitleBarButton}">
      <Style.Triggers>
        <Trigger Property="IsChecked" Value="True">
          <Setter Property="Background" Value="{DynamicResource LumiAccentBrush}" />
          <Setter Property="Foreground" Value="{DynamicResource LumiNoteActionSelectedBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- 底部格式工具：图标本身 16–18 DIP，命中区域保持 28 DIP。 -->
    <Style x:Key="FormatButton" TargetType="Button">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Margin" Value="1,0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource LumiNoteActionBrush}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                TextElement.Foreground="{TemplateBinding Foreground}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource LumiNoteActionHoverSurfaceBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource LumiNoteActionHoverBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource LumiNoteActionPressedSurfaceBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource LumiAccentBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <!-- §15.1 的尺寸常量：标题条 36 DIP -->
      <RowDefinition Height="36" />
      <RowDefinition Height="*" />
      <!-- 格式工具栏兼作状态条 -->
      <RowDefinition Height="38" />
    </Grid.RowDefinitions>

    <!-- 标题栏（§15.2）：左标题，右侧操作按钮 -->
    <Border Grid.Row="0"
            Background="{DynamicResource LumiNoteChromeBrush}"
            MouseLeftButtonDown="OnTitleBarMouseDown">
      <Grid Margin="14,0,7,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0"
                   Text="{Binding Title}"
                   VerticalAlignment="Center"
                   FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis" />

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <ToggleButton Style="{StaticResource TitleBarToggleButton}"
                        IsChecked="{Binding IsTopMost, Mode=TwoWay}"
                        ToolTip="置顶"
                        Content="⬆" />
          <Button Style="{StaticResource TitleBarButton}"
                  Click="OnCloseClick"
                  ToolTip="关闭"
                  Content="✕" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- 编辑区（本轮只做编辑态，预览态随后接上 §15.6） -->
    <Border Grid.Row="1" Background="{DynamicResource LumiNoteEditorBrush}" />

    <TextBox x:Name="Editor"
             Grid.Row="1"
             Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}"
             AcceptsReturn="True"
             TextWrapping="Wrap"
             VerticalScrollBarVisibility="Auto"
             BorderThickness="0"
             Background="Transparent"
             Foreground="{DynamicResource LumiNoteTextBrush}"
             Padding="14,12"
             CaretBrush="{DynamicResource LumiNoteActionBrush}"
             SelectionBrush="{DynamicResource LumiAccentBrush}"
             SpellCheck.IsEnabled="False"
             PreviewKeyDown="OnEditorPreviewKeyDown" />

    <!-- 高频格式常驻，状态与字数放到右侧；低频编辑动作以后进入更多菜单。 -->
    <Border Grid.Row="2" Background="{DynamicResource LumiNoteChromeBrush}" Padding="7,0,10,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{StaticResource FormatButton}"
                  Tag="Bold"
                  Click="OnFormatClick"
                  ToolTip="粗体（Ctrl+B）"
                  AutomationProperties.Name="粗体">
            <TextBlock Text="B" FontSize="16" FontWeight="Bold" />
          </Button>
          <Button Style="{StaticResource FormatButton}"
                  Tag="Italic"
                  Click="OnFormatClick"
                  ToolTip="斜体（Ctrl+I）"
                  AutomationProperties.Name="斜体">
            <TextBlock Text="I" FontSize="16" FontStyle="Italic" />
          </Button>
          <Button Style="{StaticResource FormatButton}"
                  Tag="Underline"
                  Click="OnFormatClick"
                  ToolTip="下划线（Ctrl+U）"
                  AutomationProperties.Name="下划线">
            <TextBlock Text="U" FontSize="15" TextDecorations="Underline" />
          </Button>
          <Button Style="{StaticResource FormatButton}"
                  Tag="Strikethrough"
                  Click="OnFormatClick"
                  ToolTip="删除线（Ctrl+Shift+X）"
                  AutomationProperties.Name="删除线">
            <TextBlock Text="S" FontSize="15" TextDecorations="Strikethrough" />
          </Button>

          <Border Width="1"
                  Height="16"
                  Margin="4,0"
                  Background="{DynamicResource LumiSubtleBorderBrush}" />

          <Button Style="{StaticResource FormatButton}"
                  Tag="TaskList"
                  Click="OnFormatClick"
                  ToolTip="待办列表"
                  AutomationProperties.Name="待办列表">
            <!-- Lucide list-todo，ISC；许可证见仓库根 THIRD_PARTY_NOTICES.md。 -->
            <Viewbox Width="17" Height="17">
              <Canvas Width="24" Height="24">
                <Path Data="M13,5 L21,5 M13,12 L21,12 M13,19 L21,19 M3,17 L5,19 L9,15"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="2"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round" />
                <Rectangle Canvas.Left="3"
                           Canvas.Top="4"
                           Width="6"
                           Height="6"
                           RadiusX="1"
                           RadiusY="1"
                           Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                           StrokeThickness="2" />
              </Canvas>
            </Viewbox>
          </Button>
          <Button Style="{StaticResource FormatButton}"
                  Tag="BulletList"
                  Click="OnFormatClick"
                  ToolTip="项目列表"
                  AutomationProperties.Name="项目列表">
            <!-- Lucide list，ISC；许可证见仓库根 THIRD_PARTY_NOTICES.md。 -->
            <Viewbox Width="17" Height="17">
              <Canvas Width="24" Height="24">
                <Path Data="M3,5 L3.01,5 M3,12 L3.01,12 M3,19 L3.01,19 M8,5 L21,5 M8,12 L21,12 M8,19 L21,19"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="2"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round" />
              </Canvas>
            </Viewbox>
          </Button>
        </StackPanel>

        <TextBlock Grid.Column="1"
                   VerticalAlignment="Center"
                   FontSize="11"
                   Foreground="{DynamicResource LumiNoteActionBrush}">
          <Run Text="{Binding StatusText, Mode=OneWay}" />
          <Run Text=" · " />
          <Run Text="{Binding CharacterCount, Mode=OneWay}" />
          <Run Text=" 字" />
        </TextBlock>
      </Grid>
    </Border>

    <!-- 玻璃边缘的亮线不接收鼠标，保留 WindowChrome 的缩放热区。 -->
    <Border Grid.RowSpan="3"
            BorderBrush="{DynamicResource LumiGlassEdgeBrush}"
            BorderThickness="1"
            CornerRadius="8"
            IsHitTestVisible="False" />
  </Grid>
</Window>
