<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="LumiText.Demo.CompareWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ltv="using:LumiText.WinUI.Controls"
    Title="LumiText M7 — RichEditBox 对照">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <!-- 左：现产品同款 RichEditBox（frost 底、墨色、内边距与 RichEditorHost 一致） -->
        <RichEditBox
            x:Name="Editor"
            Grid.Column="0"
            Padding="18,16,18,16"
            IsReadOnly="True"
            BorderThickness="0"
            CornerRadius="0" />

        <!-- 右：LumiDocumentView（同内边距、同 frost 底） -->
        <Grid
            Grid.Column="1"
            x:Name="RightFrost"
            Padding="18,16,18,16">
            <ltv:LumiDocumentView x:Name="DocView" />
        </Grid>
    </Grid>
</Window>
