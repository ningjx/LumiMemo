<Window
    x:Class="LumiText.Demo.EditWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:LumiText.WinUI.Controls"
    Title="LumiEditor 冒烟（M3/M4）">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12" Margin="16,12">
            <TextBlock x:Name="StatsText" VerticalAlignment="Center" FontSize="12"/>
            <ToggleButton x:Name="DebugToggle" Content="调试框线" FontSize="12"/>
        </StackPanel>

        <controls:LumiEditor x:Name="Editor" Grid.Row="1" Margin="16,0,16,16"/>
    </Grid>
</Window>
