<?xml version="1.0" encoding="utf-8"?>
<!--
  集中管理包版本（Central Package Management）。
  依据文档 §2.2 的依赖清单：每一项都有明确用途，替换前需评估代价。

  各工程的引用范围（§4.1）：
    Core            零第三方依赖
    Infrastructure  YamlDotNet、Markdig、Microsoft.Windows.CsWin32
    App             CommunityToolkit.Mvvm、H.NotifyIcon.Wpf、Microsoft.Extensions.*
-->
<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- 不自动提升传递依赖的版本，避免 Core 被间接引入第三方包 -->
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="App：MVVM 与托盘（§2.2）">
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Label="Infrastructure：解析与互操作（§2.2）">
    <PackageVersion Include="Markdig" Version="1.3.2" />
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
    <PackageVersion Include="Microsoft.Windows.CsWin32" Version="0.3.333" />
    <!--
      §4.1 的依赖清单里没写这一条，但 §4.2 又规划了
      Infrastructure/Logging/RollingFileLoggerProvider.cs，而实现它、以及让仓储层
      能记录「某文件解析降级了」这类信息，都需要 ILogger<T> 这个抽象。
      取 Abstractions 而不是完整实现：这里只需要接口，具体 provider 由 App 层在
      组装 DI 时决定（§8.3），Infrastructure 不该反过来规定日志怎么写。
    -->
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
  </ItemGroup>

  <!--
    测试（§21）。只有 xunit.v3 一条。

    .NET 10 SDK 上 Microsoft.Testing.Platform 不再支持 VSTest 目标，
    测试工程直接编译成可执行文件（OutputType=Exe）由 MTP 自己跑，
    因此不需要 Microsoft.NET.Test.Sdk，也不需要 xunit.runner.visualstudio
    （那两个是 VSTest 路径的组件，引进来反而制造冲突）。
    运行方式的开关在仓库根的 global.json，不在包引用里。
  -->
  <ItemGroup Label="测试（§21）">
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>

</Project>
