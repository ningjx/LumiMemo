<?xml version="1.0" encoding="utf-8"?>
<!--
  spikes/ 专用版本表（独立 CPM，不影响 src/ 主项目）。
  版本与主项目对齐；Win2D 版本是 R1 验证对象，首选 1.4.0，冲突时降级 1.3.3。
-->
<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <!--
      注意：WASDK 2.5.1 元包自身就传递依赖 Microsoft.WindowsAppSDK.WinUI 2.3.9
      （WinUI 子包线没有 2.4+ 版本），与主项目解析结果一致，不要显式钉 WinUI 子包。
      Win2D 1.4.0 要求 WinUI 子包 >= 1.8，2.3.9 满足，R1 包结构层面兼容。
    -->
    <PackageVersion Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageVersion Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
  </ItemGroup>

</Project>
